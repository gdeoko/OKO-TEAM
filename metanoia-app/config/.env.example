# МЕТАНОЙЯ · переменные окружения (реальный .env НЕ коммитится)
# Скопируйте в config/.env и заполните. Файл лежит ВНЕ public_html.

# ── База данных ─────────────────────────────────────────────
DB_HOST=localhost
DB_NAME=metanoia
DB_USER=
DB_PASS=

# ── Приложение ──────────────────────────────────────────────
APP_ORIGIN=https://app.metanoia-180.ru
APP_DEBUG=0
JWT_SECRET=            # длинная случайная строка (openssl rand -hex 32)

# ── Оплата: Lava.top (подписки Метанойя+ и пожертвования) ────
# Личный кабинет Lava.top → раздел API.
LAVA_API_KEY=          # ключ API
LAVA_SECRET=           # секрет для проверки подписи вебхука
LAVA_SHOP_ID=          # id магазина (если требуется)
LAVA_OFFER_MONTH=      # offerId тарифа «Месяц» (490 ₽)
LAVA_OFFER_YEAR=       # offerId тарифа «Год» (3900 ₽)
LAVA_OFFER_LIFETIME=   # offerId «Навсегда» (9900 ₽)
LAVA_OFFER_DONATION=   # offerId для пожертвований (свободная сумма)

# ── Соц-входы ───────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=   # Google Cloud Console → OAuth 2.0 Client ID (Web)
TELEGRAM_BOT_TOKEN=       # @BotFather → токен бота @metanoia_180_bot

# ── Почта (верификация email, восстановление пароля) ────────
SENDGRID_API_KEY=      # sendgrid.com (100 писем/день бесплатно)
MAIL_FROM=noreply@metanoia-180.ru

# ── AI-фабрика уроков и push (этап 7) ───────────────────────
CLAUDE_API_KEY=
YOUTUBE_API_KEY=
FIREBASE_SERVER_KEY=
