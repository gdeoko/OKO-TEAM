# Rocket CDN · настройки веб-сервера
Options -Indexes
ServerSignature Off
AddDefaultCharset UTF-8
DirectoryIndex index.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# Кэш статики
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png              "access plus 1 month"
  ExpiresByType image/jpeg             "access plus 1 month"
  ExpiresByType image/svg+xml          "access plus 1 month"
  ExpiresByType image/webp             "access plus 1 month"
  ExpiresByType font/woff2             "access plus 1 year"
  ExpiresByType audio/mpeg             "access plus 1 year"
  ExpiresByType text/css               "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml
</IfModule>

# Шрифты отдаём с правильным типом
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  # Без этого сервер отдаёт паспорт приложения как поток байтов, и
  # браузер его просто не читает: ни имени, ни иконок, ни цвета.
  AddType application/manifest+json .webmanifest
</IfModule>

# Служебные файлы наружу не отдаём
<FilesMatch "^(config\.php|config\.local\.php|lib_report\.php|cron\.php|bot\.php|.*\.log|.*\.json)$">
  Require all denied
</FilesMatch>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^data/ - [F,L]
</IfModule>
