# Правильные MIME-типы для 3D-моделей, WASM и WebP (нужно для Draco и текстур)
AddType application/wasm .wasm
AddType model/gltf-binary .glb
AddType image/webp .webp
AddType application/javascript .js

# Кеш статики
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType application/wasm "access plus 1 month"
  ExpiresByType model/gltf-binary "access plus 1 month"
  # HTML НИКОГДА не кэшируем → новая сборка (новый хэш JS) подхватывается сразу
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# HTML — жёсткий no-cache (браузер всегда берёт свежий index.html, без «застрявшей» версии)
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # --- Красивые ссылки (одно слово, без .html) — файлы лежат в корне ---
  RewriteRule ^system/?$   system.html   [L]
  RewriteRule ^pravila/?$  pravila.html  [L]
  RewriteRule ^lyudi/?$    lyudi.html    [L]
  RewriteRule ^mozg/?$     mozg.html     [L]
  RewriteRule ^shagi/?$    shagi.html    [L]

  # --- Бэкенд: api и админка обслуживаются напрямую (НЕ как SPA) ---
  RewriteRule ^api/?$               api.php                      [L]
  RewriteRule ^admin/?$             admin/index.php              [L]

  # SPA: всё остальное, если файла/папки нет → index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
