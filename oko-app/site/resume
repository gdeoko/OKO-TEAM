<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Даниэль Ильясов — Digital-продюсер · OKO TEAM</title>
<meta name="description" content="Резюме Даниэля Ильясова — Digital-продюсер, OKO TEAM. 7+ лет, 150+ проектов, 50+ ниш.">
<link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@400;700;900&family=Onest:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box}
:root{--lime:#9AFF00;--lime2:rgba(154,255,0,.1);--lime3:rgba(154,255,0,.25);--glass:rgba(255,255,255,.04);--border:rgba(255,255,255,.08);--w2:rgba(255,255,255,.75);--w3:rgba(255,255,255,.45)}
html{scroll-behavior:smooth;scroll-padding-top:62px}
body{background:#050505;color:#fff;font-family:'Onest',sans-serif;overflow-x:hidden;line-height:1.6}
#bg{position:fixed;top:0;left:0;width:100%;height:100%;z-index:0;pointer-events:none}
.pb{position:fixed;top:0;left:0;height:2px;background:var(--lime);z-index:1000;width:0;box-shadow:0 0 8px rgba(154,255,0,.5);transition:width .1s}
.wrap{max-width:1080px;margin:0 auto;padding:0 18px;position:relative;z-index:1}
section{position:relative;z-index:1}
.sec-sep{height:1px;background:linear-gradient(to right,transparent,rgba(154,255,0,.35),transparent)}
.rv{opacity:0;transform:translateY(16px);transition:opacity .5s,transform .5s}
.rv.vis{opacity:1;transform:none}
.sec-lbl{font-size:10px;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:var(--lime);margin-bottom:8px}
.sec-h{font-family:'Unbounded',sans-serif;font-size:clamp(18px,2.5vw,30px);font-weight:900;line-height:1.15;margin-bottom:12px}

/* NAV */
.nav{position:fixed;top:0;left:0;right:0;z-index:200;display:flex;align-items:center;justify-content:space-between;padding:10px 18px;background:rgba(5,5,5,.6);backdrop-filter:blur(20px);border-bottom:1px solid rgba(154,255,0,.06);transition:background .3s;gap:10px}
.nav.scrolled{background:rgba(5,5,5,.96)}
.nav-logo{display:flex;align-items:center;gap:8px;text-decoration:none;flex-shrink:0}
.nav-logo img{width:26px;height:26px;object-fit:contain;border-radius:5px}
.nav-logo-t{font-family:'Unbounded',sans-serif;font-size:11px;font-weight:900;color:#fff;line-height:1.1}
.nav-logo-s{font-size:8px;color:var(--lime);font-weight:700;letter-spacing:1.5px;text-transform:uppercase}
.nav-links{display:flex;align-items:center;gap:1px;flex:1;justify-content:center}
.nav-a{color:rgba(255,255,255,.5);font-size:11px;font-weight:600;padding:6px 10px;border-radius:18px;text-decoration:none;transition:all .2s;white-space:nowrap}
.nav-a:hover{color:#fff;background:rgba(255,255,255,.06)}
.nav-cta{background:var(--lime);color:#000;font-weight:800;font-size:11px;padding:7px 14px;border-radius:18px;text-decoration:none;white-space:nowrap;flex-shrink:0;animation:pglow 2.5s infinite}
.nav-cta:hover{opacity:.87}
.ham{display:none;background:none;border:1px solid rgba(255,255,255,.15);color:#fff;padding:6px 9px;border-radius:8px;cursor:pointer;font-size:14px;flex-shrink:0}
.mob-nav{display:none;position:fixed;top:55px;left:0;right:0;bottom:0;background:rgba(5,5,5,.97);z-index:199;padding:12px;flex-direction:column;gap:5px;backdrop-filter:blur(20px);overflow-y:auto}
.mob-nav.open{display:flex}
.mob-nav .nav-a{font-size:13px;padding:11px 14px;border-radius:11px;border:1px solid rgba(255,255,255,.07);color:rgba(255,255,255,.8);display:flex;align-items:center;gap:11px;text-decoration:none;transition:all .2s}
.mob-nav .nav-a:hover{background:rgba(154,255,0,.06);border-color:rgba(154,255,0,.2);color:#fff}
.mob-nav .nav-a svg{flex-shrink:0;color:var(--lime);opacity:.8}
.mob-nav .nav-a span{flex:1}
.mob-nav .nav-cta{text-align:center;padding:14px;border-radius:12px;font-size:13px;display:flex;align-items:center;justify-content:center;gap:8px;margin-top:6px;animation:pglow 2.5s infinite;text-decoration:none;font-weight:800}
@keyframes pglow{0%,100%{box-shadow:0 0 12px rgba(154,255,0,.3)}50%{box-shadow:0 0 24px rgba(154,255,0,.6)}}
@media(max-width:720px){.nav-links{display:none}.ham{display:block}}

/* BUTTONS */
.btn-p{display:inline-flex;align-items:center;gap:7px;background:var(--lime);color:#000;font-size:13px;padding:12px 22px;font-weight:800;border-radius:12px;text-decoration:none;cursor:pointer;font-family:'Onest',sans-serif;white-space:nowrap;animation:pglow 2.5s infinite;transition:all .2s;border:none}
.btn-p:hover{opacity:.87;transform:translateY(-1px)}
.btn-s{display:inline-flex;align-items:center;gap:7px;background:rgba(255,255,255,.05);color:#fff;font-size:13px;padding:12px 18px;border:1px solid rgba(255,255,255,.15);border-radius:12px;text-decoration:none;cursor:pointer;font-family:'Onest',sans-serif;font-weight:700;white-space:nowrap;transition:all .2s}
.btn-s:hover{background:rgba(255,255,255,.09);border-color:rgba(255,255,255,.3)}
.btn-more{background:var(--glass);border:1px solid rgba(154,255,0,.25);color:var(--lime);font-size:11px;font-weight:700;padding:9px 14px;border-radius:20px;cursor:pointer;margin-bottom:10px;transition:all .2s;font-family:'Onest',sans-serif;width:100%;text-align:center}
.btn-more:hover{background:rgba(154,255,0,.08)}

/* HERO */
.hero{display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:80px 14px 28px;position:relative;overflow:hidden}
#hcv{position:absolute;inset:0;z-index:0;pointer-events:none}
.hero-content{position:relative;z-index:2;width:100%;max-width:820px}
.hero-badge{display:inline-flex;align-items:center;gap:7px;background:rgba(154,255,0,.07);border:1px solid rgba(154,255,0,.2);color:var(--lime);font-size:9px;font-weight:700;letter-spacing:1px;text-transform:uppercase;padding:6px 14px;border-radius:40px;margin-bottom:14px}
.hbdot{width:5px;height:5px;background:var(--lime);border-radius:50%;animation:blink 2s infinite;flex-shrink:0}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.2}}
.hero-ava{width:96px;height:96px;border-radius:50%;border:2.5px solid var(--lime);overflow:hidden;margin:0 auto 14px;box-shadow:0 0 26px rgba(154,255,0,.25)}
.hero-ava img{width:100%;height:100%;object-fit:cover;object-position:top}
.hero-title{font-family:'Unbounded',sans-serif;font-size:clamp(32px,7vw,72px);font-weight:900;line-height:1.0;margin-bottom:7px;letter-spacing:-2px}
.hero-title .lime{color:var(--lime)}
.hero-sub{font-size:clamp(12px,1.8vw,15px);color:var(--w3);margin-bottom:16px}
.hero-banner{width:100%;max-width:640px;margin:0 auto 18px;border-radius:13px;overflow:hidden;border:1px solid rgba(154,255,0,.18);box-shadow:0 0 28px rgba(154,255,0,.07)}
.hero-banner img{width:100%;display:block}
.hero-stats{display:flex;gap:5px;justify-content:center;margin:0 auto 18px;flex-wrap:nowrap}
.h-stat{background:rgba(154,255,0,.06);border:1px solid rgba(154,255,0,.22);border-radius:10px;padding:9px 6px;display:flex;flex-direction:column;align-items:center;flex:1;min-width:0;transition:all .25s}
.h-stat:hover{border-color:var(--lime);background:rgba(154,255,0,.1);transform:translateY(-2px)}
.h-stat-n{font-family:'Unbounded',sans-serif;font-size:clamp(11px,3vw,17px);font-weight:900;color:var(--lime);white-space:nowrap}
.h-stat-l{font-size:8px;color:var(--w3);margin-top:2px;white-space:nowrap}
.hero-btns{display:flex;gap:8px;justify-content:center;flex-wrap:nowrap}
@media(max-width:360px){.hero-btns{flex-wrap:wrap}}

/* ABOUT */
.about{padding:52px 0}
.about-grid{display:flex;flex-direction:column;gap:18px;margin-top:18px}

.about-text p{font-size:13px;color:var(--w2);line-height:1.7;margin-bottom:9px}
.about-more{display:none;margin-top:4px}
.about-more.open{display:block}
.about-photo{border-radius:13px;overflow:hidden;border:1px solid rgba(154,255,0,.12)}
.about-photo img{width:100%;aspect-ratio:16/9;height:auto;object-fit:cover;object-position:center center;display:block}

/* WHY */
.why{padding:52px 0}
.why-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin-top:18px}
@media(max-width:560px){.why-grid{grid-template-columns:1fr 1fr}}
.why-card{background:var(--glass);border:1px solid var(--border);border-radius:13px;padding:15px;transition:all .3s}
.why-card:hover{border-color:rgba(154,255,0,.3);background:rgba(154,255,0,.04)}
.why-ico{margin-bottom:8px;color:var(--lime)}
.why-ico svg{width:18px;height:18px}
.why-title{font-weight:700;font-size:12px;color:var(--lime);margin-bottom:4px}
.why-desc{font-size:11px;color:var(--w3);line-height:1.55}

/* SERVICES */
.services{padding:52px 0}
.srv-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:18px}
@media(max-width:560px){.srv-grid{grid-template-columns:1fr}}
.srv-card{background:var(--glass);border:1px solid var(--border);border-radius:14px;padding:18px;transition:all .3s;display:flex;flex-direction:column}.srv-header{display:flex;align-items:center;gap:10px;margin-bottom:12px}
.srv-card:hover{border-color:rgba(154,255,0,.35);background:rgba(154,255,0,.03)}
.srv-ico{color:var(--lime);flex-shrink:0}
.srv-ico svg{width:20px;height:20px;display:block}
.srv-title{font-family:'Unbounded',sans-serif;font-size:11px;font-weight:700;color:var(--lime)}
.srv-list{list-style:none;margin-bottom:10px}
.srv-list li{font-size:11px;color:var(--w3);padding:2px 0;display:flex;gap:5px;align-items:flex-start}
.srv-list li::before{content:'→';color:var(--lime);flex-shrink:0}
.srv-more-body{display:none;margin-top:4px}
.srv-more-body.open{display:block}
.srv-link{display:flex;align-items:center;justify-content:center;gap:6px;background:rgba(154,255,0,.08);border:1px solid rgba(154,255,0,.35);color:var(--lime);font-size:12px;font-weight:800;padding:11px 14px;border-radius:20px;text-decoration:none;text-transform:uppercase;letter-spacing:1px;transition:all .2s;margin-top:auto;width:100%;text-align:center}.srv-link:hover{background:rgba(154,255,0,.18);border-color:var(--lime)}

/* EXPERIENCE */
.experience{padding:52px 0}
.exp-list{margin-top:18px;display:flex;flex-direction:column;gap:7px}
.exp-item{background:var(--glass);border:1px solid var(--border);border-radius:13px;overflow:hidden;border-left:3px solid var(--lime);transition:border-color .3s}
.exp-item.open{border-color:rgba(154,255,0,.5)}
.exp-head{padding:14px 16px;cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:10px}
.exp-head:hover .exp-company{color:var(--lime)}
.exp-company{font-weight:700;font-size:13px;transition:color .2s}
.exp-meta{display:flex;align-items:center;gap:7px;flex-shrink:0}
.exp-period{font-size:10px;color:var(--lime);background:rgba(154,255,0,.1);padding:3px 9px;border-radius:14px;font-weight:700;white-space:nowrap}
.exp-arr{color:var(--lime);transition:transform .3s;flex-shrink:0}
.exp-item.open .exp-arr{transform:rotate(180deg)}
.exp-body{display:none;padding:0 16px 14px}
.exp-item.open .exp-body{display:block}
.exp-role{font-size:12px;color:var(--lime);font-weight:600;margin-bottom:9px}
.exp-img{border-radius:9px;overflow:hidden;border:1px solid rgba(154,255,0,.12);margin-bottom:9px;max-width:340px}
.exp-img img{width:100%;display:block}
.exp-pts{list-style:none}
.exp-pts li{font-size:12px;color:var(--w3);padding:2px 0;display:flex;gap:7px;align-items:flex-start}
.exp-pts li::before{content:'→';color:var(--lime);flex-shrink:0}

/* EDUCATION */
.education{padding:36px 0}
.edu-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:9px;margin-top:14px}
@media(max-width:480px){.edu-grid{grid-template-columns:1fr}}
.edu-card{background:var(--glass);border:1px solid var(--border);border-radius:11px;padding:13px 15px}
.edu-org{font-weight:700;font-size:13px;margin-bottom:3px}
.edu-desc{font-size:11px;color:var(--w3)}

/* CASES */
.cases{padding:52px 0}
.case-plat{display:inline-block;font-size:8px;font-weight:700;padding:2px 7px;border-radius:7px;letter-spacing:.5px;text-transform:uppercase}
.plat-ig{background:rgba(225,48,108,.15);color:#e1306c}
.plat-tt{background:rgba(255,255,255,.08);color:#fff;border:1px solid rgba(255,255,255,.15)}
.plat-yt{background:rgba(255,0,0,.15);color:#ff4444}
.cases-list{display:flex;flex-direction:column;gap:8px;margin-top:18px}
.citem{background:var(--glass);border:1px solid var(--border);border-radius:13px;display:flex;align-items:stretch;overflow:hidden;transition:all .25s;text-decoration:none}
.citem:hover{border-color:rgba(154,255,0,.35);background:rgba(154,255,0,.025)}
.citem-ava{width:62px;flex-shrink:0;overflow:hidden}
.citem-ava img{width:100%;height:100%;object-fit:cover;object-position:top;display:block}
.citem-ava-ph{width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:22px;background:rgba(154,255,0,.06)}
.citem-body{flex:1;min-width:0;padding:9px 11px;display:flex;flex-direction:column;gap:2px}
.citem-top{display:flex;align-items:center;gap:6px;flex-wrap:wrap}
.citem-handle{font-weight:700;font-size:12px;color:#fff}
.citem-niche{font-size:10px;color:var(--w3)}
.citem-nums{font-size:10px;color:rgba(255,255,255,.5)}
.citem-detail{font-size:10px;color:rgba(255,255,255,.38);line-height:1.4;margin-top:1px}
.citem-tags{display:flex;gap:4px;flex-wrap:wrap;margin-top:3px}
.citem-tag{font-size:9px;color:rgba(154,255,0,.65);background:rgba(154,255,0,.07);border:1px solid rgba(154,255,0,.15);padding:1px 6px;border-radius:7px;white-space:nowrap}
.citem-right{display:flex;flex-direction:column;align-items:flex-end;justify-content:center;padding:9px 11px;flex-shrink:0;gap:3px}
.citem-growth{font-family:'Unbounded',sans-serif;font-size:15px;font-weight:900;color:var(--lime);white-space:nowrap}
.citem-profit{font-size:9px;color:rgba(154,255,0,.55);white-space:nowrap;text-align:right}
.citem-period{font-size:9px;color:var(--w3);white-space:nowrap}
.citem-link{display:inline-flex;align-items:center;gap:3px;font-size:9px;color:var(--lime);font-weight:700;text-decoration:none;border:1px solid rgba(154,255,0,.2);padding:3px 8px;border-radius:10px;transition:all .2s;margin-top:2px}
.citem-link:hover{background:rgba(154,255,0,.1)}
.cases-links{display:flex;gap:8px;justify-content:center;margin-top:14px;flex-wrap:wrap}
.cases-link{display:inline-flex;align-items:center;gap:5px;background:rgba(154,255,0,.07);border:1px solid rgba(154,255,0,.2);color:var(--lime);font-size:11px;font-weight:700;padding:6px 13px;border-radius:18px;text-decoration:none;transition:all .2s}
.cases-link:hover{background:rgba(154,255,0,.14)}

/* REVIEWS */
.reviews{padding:52px 0}
.vc-wrap{overflow:hidden;margin-top:18px;cursor:grab;user-select:none}
.vc-wrap:active{cursor:grabbing}
.vc-track{display:flex;gap:14px;will-change:transform}
.vc-item-wrap{flex-shrink:0;display:flex;flex-direction:column;align-items:center}
.vc-item{width:90px;height:90px;border-radius:50%;overflow:hidden;border:2.5px solid rgba(154,255,0,.25);position:relative;cursor:pointer;transition:border-color .3s}
.vc-item:hover,.vc-item.playing{border-color:var(--lime);box-shadow:0 0 16px rgba(154,255,0,.2)}
.vc-item video{width:100%;height:100%;object-fit:cover;display:block}
.vc-overlay{position:absolute;inset:0;background:rgba(0,0,0,.3);display:flex;align-items:center;justify-content:center;transition:opacity .2s}
.vc-item.playing .vc-overlay{opacity:0}
.vc-play{width:26px;height:26px;background:rgba(0,0,0,.5);border:2px solid rgba(154,255,0,.7);border-radius:50%;display:flex;align-items:center;justify-content:center;color:var(--lime)}
.vc-name{text-align:center;font-size:10px;color:var(--w3);margin-top:5px;font-weight:500}

.audio-rev{display:flex;align-items:center;gap:11px;background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.07);border-radius:12px;padding:12px 14px;margin:14px 0;cursor:pointer;transition:border-color .3s}
.audio-rev:hover{border-color:rgba(154,255,0,.2)}
.ar-btn{width:36px;height:36px;background:var(--lime);border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;border:none;cursor:pointer;transition:all .2s}
.ar-btn svg{color:#000;margin-left:2px}
.ar-btn:hover{transform:scale(1.05)}
.ar-info{display:flex;flex-direction:column;flex-shrink:0}
.ar-name{font-size:12px;font-weight:700;margin-bottom:1px}
.ar-sub{font-size:10px;color:var(--w3)}
.ar-wave{display:flex;align-items:center;gap:2px;height:24px;flex:1}
.ar-wave b{display:block;width:3px;border-radius:3px;background:rgba(154,255,0,.3);animation:ovw 1.2s ease-in-out infinite;flex:1;max-width:4px}
.ar-wave.pl b{background:var(--lime)}
@keyframes ovw{0%,100%{transform:scaleY(1)}50%{transform:scaleY(2.2)}}

.rev-wrap{overflow:hidden;margin-top:14px;cursor:grab;user-select:none}
.rev-wrap:active{cursor:grabbing}
.rev-track{display:flex;gap:11px;will-change:transform}
.rev-card{flex-shrink:0;width:240px;background:var(--glass);border:1px solid var(--border);border-radius:13px;padding:15px}
.rev-stars{color:var(--lime);font-size:11px;margin-bottom:6px;letter-spacing:2px}
.rev-text{font-size:11px;color:var(--w2);line-height:1.6;margin-bottom:9px;font-style:italic}
.rev-author{display:flex;align-items:center;gap:8px}
.rev-ava{width:28px;height:28px;background:rgba(154,255,0,.15);border:1px solid rgba(154,255,0,.3);border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:11px;color:var(--lime);flex-shrink:0}
.rev-name{font-weight:700;font-size:11px}
.rev-role{font-size:9px;color:var(--w3)}
.rev-more{display:inline-flex;align-items:center;gap:5px;background:rgba(154,255,0,.07);border:1px solid rgba(154,255,0,.2);color:var(--lime);font-size:11px;font-weight:700;padding:7px 14px;border-radius:18px;text-decoration:none;transition:all .2s}
.rev-more:hover{background:rgba(154,255,0,.14)}

/* PORTFOLIO */
.portfolio{padding:52px 0}
.port-wrap{overflow:hidden;cursor:grab;user-select:none;padding:0 18px;margin-top:18px}
.port-wrap:active{cursor:grabbing}
.port-track{display:flex;gap:10px;will-change:transform}
.port-card{flex-shrink:0;width:170px;background:var(--glass);border:1px solid var(--border);border-radius:11px;overflow:hidden;transition:border-color .3s}
.port-card:hover{border-color:rgba(154,255,0,.3)}
.port-vid{aspect-ratio:3/4;overflow:hidden;background:#0a0a0a;position:relative}
.port-vid video{width:100%;height:100%;object-fit:cover;display:block}
.port-info{padding:7px 9px}
.port-type{font-size:7px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--lime);margin-bottom:2px}
.port-name{font-size:10px;font-weight:600;margin-bottom:3px}
.port-link{font-size:9px;color:var(--lime);text-decoration:none;font-weight:700}

/* FAQ */
.faq{padding:52px 0}
.faq-list{margin-top:18px;display:flex;flex-direction:column;gap:7px}
.faq-item{background:var(--glass);border:1px solid var(--border);border-radius:11px;overflow:hidden;transition:border-color .3s}
.faq-item.open{border-color:rgba(154,255,0,.25)}
.faq-q{padding:13px 16px;cursor:pointer;font-weight:600;font-size:13px;display:flex;justify-content:space-between;align-items:center;gap:10px;user-select:none}
.faq-q:hover{color:var(--lime)}
.faq-arr{width:20px;height:20px;background:rgba(154,255,0,.1);border:1px solid rgba(154,255,0,.2);border-radius:50%;display:flex;align-items:center;justify-content:center;color:var(--lime);flex-shrink:0;transition:transform .3s}
.faq-item.open .faq-arr{transform:rotate(45deg);background:rgba(154,255,0,.18)}
.faq-a{display:none;padding:0 16px 13px;font-size:12px;color:var(--w3);line-height:1.7}
.faq-a a{color:var(--lime)}
.faq-item.open .faq-a{display:block}

/* DOWNLOADS */
.downloads{padding:44px 0}
.dl-row{display:flex;gap:10px;margin-top:14px;flex-wrap:nowrap}
@media(max-width:460px){.dl-row{flex-wrap:wrap}}
.dl-card{flex:1;background:var(--glass);border:1px solid var(--border);border-radius:13px;padding:16px 14px;display:flex;align-items:center;gap:11px;text-decoration:none;color:#fff;transition:all .3s;cursor:pointer;min-width:0}
.dl-card:hover{border-color:rgba(154,255,0,.4);background:rgba(154,255,0,.04);transform:translateY(-2px)}
.dl-ico{width:38px;height:38px;background:rgba(154,255,0,.1);border:1px solid rgba(154,255,0,.2);border-radius:9px;display:flex;align-items:center;justify-content:center;color:var(--lime);flex-shrink:0}
.dl-ico svg{width:16px;height:16px}
.dl-title{font-weight:700;font-size:12px;margin-bottom:2px}
.dl-sub{font-size:10px;color:var(--w3)}
.dl-arr{margin-left:auto;color:var(--lime);flex-shrink:0}
.dl-arr svg{width:15px;height:15px}
.req-box{background:rgba(154,255,0,.04);border:1px solid rgba(154,255,0,.15);border-radius:13px;padding:14px 16px;margin-top:10px}
.req-title{font-size:10px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--lime);margin-bottom:9px}
.req-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:5px}
@media(max-width:420px){.req-grid{grid-template-columns:1fr}}
.req-item{font-size:11px;color:var(--w3)}
.req-item b{color:var(--w2);font-weight:600}

/* CTA */
.cta-sec{padding:64px 0;text-align:center}
.cta-ava{width:68px;height:68px;border-radius:50%;object-fit:cover;object-position:top;border:2.5px solid var(--lime);box-shadow:0 0 26px rgba(154,255,0,.25);margin:0 auto 14px;display:block}
.cta-title{font-family:'Unbounded',sans-serif;font-size:clamp(20px,4vw,36px);font-weight:900;margin-bottom:9px}
.cta-sub{font-size:13px;color:var(--w3);margin-bottom:22px;max-width:440px;margin-left:auto;margin-right:auto}
.cta-btns{display:flex;gap:8px;justify-content:center;flex-wrap:wrap}
.cta-contacts{margin-top:14px;font-size:11px;color:var(--w3)}

/* FOOTER */
.foot{padding:20px 0;border-top:1px solid rgba(255,255,255,.06)}
.foot-inner{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px}
.foot-brand{display:flex;align-items:center;gap:7px}
.foot-brand img{width:22px;height:22px;object-fit:contain}
.foot-brand-t{font-family:'Unbounded',sans-serif;font-size:10px;font-weight:900}
.foot-links{display:flex;gap:11px;flex-wrap:wrap}
.foot-link{color:var(--w3);font-size:11px;text-decoration:none;transition:color .2s}
.foot-link:hover{color:var(--lime)}
.foot-copy{font-size:10px;color:rgba(255,255,255,.2)}

/* STICKY CTA */
.sticky-cta{position:fixed;bottom:18px;right:18px;z-index:100;background:var(--lime);color:#000;font-weight:800;font-size:12px;padding:11px 18px;border-radius:36px;text-decoration:none;display:flex;align-items:center;gap:6px;box-shadow:0 6px 26px rgba(154,255,0,.35);animation:pglow 2.5s infinite;transition:all .2s}
.sticky-cta:hover{transform:translateY(-2px)}
.sticky-cta svg{width:14px;height:14px;flex-shrink:0}
@media(max-width:400px){.sticky-cta{bottom:12px;right:12px;padding:10px 15px;font-size:11px}}
</style>
</head>
