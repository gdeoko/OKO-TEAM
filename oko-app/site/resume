(function(){var c=document.getElementById('bg'),ctx=c.getContext('2d');var W,H,pts=[],mx=-9999,my=-9999;function init(){W=c.width=window.innerWidth;H=c.height=window.innerHeight;pts=[];var n=Math.floor(W*H/18000);for(var i=0;i<n;i++)pts.push({x:Math.random()*W,y:Math.random()*H,vx:(Math.random()-.5)*.25,vy:(Math.random()-.5)*.25,r:.6+Math.random()*1.4,op:.05+Math.random()*.18});}window.addEventListener('resize',init);init();window.addEventListener('mousemove',function(e){mx=e.clientX;my=e.clientY;});window.addEventListener('touchstart',function(e){var t=e.touches[0];mx=t.clientX;my=t.clientY;},{passive:true});var ATTR=140,FORCE=.03,_last=0;function draw(ts){requestAnimationFrame(draw);if(ts-_last<33)return;_last=ts;ctx.fillStyle='rgba(5,5,5,0.07)';ctx.fillRect(0,0,W,H);for(var i=0;i<pts.length;i++){var p=pts[i];var dx=mx-p.x,dy=my-p.y,d=Math.sqrt(dx*dx+dy*dy);if(d<ATTR&&d>1){var f=FORCE*(1-d/ATTR);p.vx+=dx/d*f;p.vy+=dy/d*f;}p.vx*=.965;p.vy*=.965;p.vx+=(Math.random()-.5)*.03;p.vy+=(Math.random()-.5)*.03;p.x+=p.vx;p.y+=p.vy;if(p.x<0)p.x=W;if(p.x>W)p.x=0;if(p.y<0)p.y=H;if(p.y>H)p.y=0;for(var j=i+1;j<pts.length;j++){var q=pts[j],cdx=p.x-q.x,cdy=p.y-q.y,cd=Math.sqrt(cdx*cdx+cdy*cdy);if(cd<80){ctx.beginPath();ctx.moveTo(p.x,p.y);ctx.lineTo(q.x,q.y);ctx.strokeStyle='rgba(154,255,0,'+(0.05*(1-cd/80)).toFixed(3)+')';ctx.lineWidth=.4;ctx.stroke();}}ctx.beginPath();ctx.arc(p.x,p.y,p.r,0,Math.PI*2);ctx.fillStyle='rgba(154,255,0,'+p.op+')';ctx.fill();};}draw();})();
