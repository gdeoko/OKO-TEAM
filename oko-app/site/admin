<script>
const API='/api.php';
let adminKey=localStorage.getItem('okoKey')||'';
let cur='dashboard';
let charts={};
let refreshTimer=null;
const REFRESH_MS={dashboard:30000,feed:15000,agents:15000,partners:60000,moderation:60000};
const PRODUCTS={sistema:'Система OKO',zavod:'Контент-завод',consult:'Консультация',bot:'Нейробот',prompt:'Промпт-пак',web:'Сайт / бот / приложение',design:'Дизайн',voronka:'Воронка + Нейробот',club:'OKO CLUB'};

/* theme */
(function(){const t=localStorage.getItem('okoTheme')||'dark';document.documentElement.setAttribute('data-theme',t)})();
function toggleTheme(){const t=document.documentElement.getAttribute('data-theme')==='light'?'dark':'light';document.documentElement.setAttribute('data-theme',t);localStorage.setItem('okoTheme',t);loadPage(cur,true)}

/* background particles */
(function bg(){
  const c=document.getElementById('bg'),x=c.getContext('2d');let W,H,ps=[];
  function rs(){W=c.width=innerWidth;H=c.height=innerHeight}rs();addEventListener('resize',rs);
  for(let i=0;i<45;i++)ps.push({x:Math.random()*innerWidth,y:Math.random()*innerHeight,vx:(Math.random()-.5)*.22,vy:(Math.random()-.5)*.22,r:Math.random()*1.4+.4,a:Math.random()});
  (function d(){x.clearRect(0,0,W,H);ps.forEach(p=>{p.x+=p.vx;p.y+=p.vy;if(p.x<0)p.x=W;if(p.x>W)p.x=0;if(p.y<0)p.y=H;if(p.y>H)p.y=0;x.beginPath();x.arc(p.x,p.y,p.r,0,7);x.fillStyle='rgba(154,255,0,'+(p.a*.32)+')';x.fill()});ps.forEach((p,i)=>ps.slice(i+1).forEach(q=>{const dd=Math.hypot(p.x-q.x,p.y-q.y);if(dd<110){x.beginPath();x.moveTo(p.x,p.y);x.lineTo(q.x,q.y);x.strokeStyle='rgba(154,255,0,'+(.05*(1-dd/110))+')';x.lineWidth=.5;x.stroke()}}));requestAnimationFrame(d)})();
})();

/* helpers */
async function api(action,extra=''){
  try{const r=await fetch(API+'?action='+action+'&key='+encodeURIComponent(adminKey)+extra+'&_='+Date.now());return await r.json()}
  catch(e){return{ok:false,error:'net'}}
}
async function apiPost(action,payload){
  payload=Object.assign({key:adminKey},payload||{});
  try{const r=await fetch(API+'?action='+action,{method:'POST',headers:{'Content-Type':'application/json','X-Admin-Key':adminKey},body:JSON.stringify(payload)});return await r.json()}
  catch(e){return{ok:false,error:'net'}}
}
function esc(s){return(s==null?'':String(s)).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]))}
function badge(st,paid){
  if(paid)return'<span class="badge b-paid">оплатил</span>';
  const m={'new':'b-new','deal':'b-deal','wait':'b-wait','ожидает':'b-wait','lead':'b-lead','banned':'b-banned','refund':'b-refund','active':'b-paid','approved':'b-paid','dialog':'b-lead','anketa':'b-anketa'};
  return'<span class="badge '+(m[st]||'b-new')+'">'+esc(st||'new')+'</span>';
}
function when(t){if(!t)return'';return String(t).replace('T',' ').slice(0,16)}
function num(v){const n=Number(String(v==null?'':v).replace(/\s/g,'').replace(/[₽руб]/g,''));return isFinite(n)?n:0}
function rub(v){const n=num(v);return n.toLocaleString('ru-RU').replace(/,/g,' ')+' ₽'}
function nice(v){const n=num(v);if(n>=1e6)return(n/1e6).toFixed(1).replace(/\.0$/,'')+'M';if(n>=1e3)return(n/1e3).toFixed(1).replace(/\.0$/,'')+'k';return String(Math.round(n))}
function ago(ts){
  if(!ts)return'';
  const now=Date.now();
  const t=new Date(String(ts).replace(' ','T')).getTime();
  if(isNaN(t))return when(ts);
  const s=Math.max(0,Math.floor((now-t)/1000));
  if(s<60)return s+' сек назад';
  if(s<3600)return Math.floor(s/60)+' мин назад';
  if(s<86400)return Math.floor(s/3600)+' ч назад';
  return Math.floor(s/86400)+' дн назад';
}
function productName(k){return PRODUCTS[k]||k||'—'}
function avatarSvg(name){
  const s=String(name||'?').trim(); const ini=(s.split(/\s+/).map(x=>x[0]).join('').slice(0,2)||'?').toUpperCase();
  let h=0; for(let i=0;i<s.length;i++) h=(h*31+s.charCodeAt(i))>>>0;
  const c1='hsl('+(h%360)+',75%,55%)'; const c2='hsl('+((h+70)%360)+',75%,45%)';
  return {ini, style:'background:linear-gradient(135deg,'+c1+','+c2+')'};
}

async function doLogin(){
  adminKey=document.getElementById('pw').value.trim();
  document.getElementById('loginErr').textContent='';
  const r=await api('admin_dashboard');
  if(r.ok){localStorage.setItem('okoKey',adminKey);document.getElementById('login').classList.add('hide');document.getElementById('app').classList.remove('hide');go('dashboard')}
  else{document.getElementById('loginErr').textContent='Неверный пароль'}
}
document.getElementById('pw').addEventListener('keydown',e=>{if(e.key==='Enter')doLogin()});
function logout(){localStorage.removeItem('okoKey');location.reload()}

const TITLES={
  dashboard:['Дашборд','Обзор в реальном времени'],
  clients:['Клиенты','CRM · база клиентов и лидов'],
  progress:['Путь клиента','Шесть отметок, статусы, соглашения и заметки'],
  dossier:['Материалы','КП, Системы, договоры и оплата по каждому клиенту'],
  feed:['Live-лента','События по мере поступления'],
  manualpay:['Ручная оплата','Провести платёж в обход webhook'],
  agents:['Агенты','Sub-агенты OKO'],
  partners:['Партнёры','Продажи и выплаты'],
  moderation:['Модерация','Анкеты и заявки'],
  finance:['Финансы','Выручка, расходы, прогноз'],
  anketas:['Анкеты','Заполненные анкеты'],
  dialogs:['Диалоги','Переписка агентов'],
  calls:['Созвоны','Записи, слоты и ссылки на Zoom'],
  deals:['Сделки','Закрытые и активные'],
  vacancies:['Вакансии','Найденные вакансии'],
  responses:['Отклики','Отправленные отклики'],
  payments:['Оплаты','История оплат'],
  products:['Продукты','Статистика по продуктам'],
  newsletter:['Рассылка','Email-рассылка по базе']
};
function go(p){
  cur=p;
  document.querySelectorAll('.nav-i').forEach(n=>n.classList.toggle('on',n.dataset.p===p));
  const t=TITLES[p]||[p,''];
  document.getElementById('pageTitle').textContent=t[0];
  document.getElementById('pageSub').textContent=t[1];
  if(innerWidth<=860)document.getElementById('side').classList.remove('open');
  loadPage(p);
  scheduleRefresh(p);
}
function scheduleRefresh(p){
  if(refreshTimer){clearInterval(refreshTimer);refreshTimer=null}
  const ms=REFRESH_MS[p];
  if(ms) refreshTimer=setInterval(()=>{if(cur===p && !document.hidden) loadPage(p,true)},ms);
}
document.addEventListener('visibilitychange',()=>{if(!document.hidden && REFRESH_MS[cur]) loadPage(cur,true)});
function toggleSide(){document.getElementById('side').classList.toggle('open')}
function markUpd(){document.getElementById('lastUpd').textContent=new Date().toLocaleTimeString('ru-RU')}

function renderDossier(box){
  // Материалы собирает сервер: он один знает и досье от агентов, и ссылки.
  box.innerHTML='<iframe id="dossierFrame" style="width:100%;min-height:78vh;border:0;'
    +'border-radius:12px;background:#0d0d0d" src="/api.php?action=dossierPage&key='
    +encodeURIComponent(adminKey||localStorage.getItem('okoKey')||'')+'"></iframe>';
}
async function loadPage(p,silent){
  const box=document.getElementById('content');
  if(!silent) box.innerHTML='<div class="spin"></div>';
  if(p==='dashboard')return renderDash(box,silent);
  if(p==='feed')return renderFeed(box);
  if(p==='manualpay')return renderManualPay(box);
  if(p==='agents')return renderAgents(box);
  if(p==='partners')return renderPartners(box);
  if(p==='moderation')return renderModeration(box);
  if(p==='finance')return renderFinance(box);
  if(p==='clients')return renderClients(box);
  if(p==='progress')return renderProgress(box);
  if(p==='dossier')return renderDossier(box);
  if(p==='anketas')return renderAnketasList(box);
  if(p==='dialogs')return renderList(box,'getDialogs','dialogs',renderDialog,'Диалогов пока нет');
  if(p==='calls')return renderList(box,'admin_calls','calls',renderCall,'Созвонов пока нет');
  if(p==='deals')return renderList(box,'getStats','deals',renderDeal,'Сделок пока нет');
  if(p==='vacancies')return renderList(box,'getVacancies','vacancies',renderVac,'Вакансий пока нет');
  if(p==='responses')return renderList(box,'getResponses','responses',renderResp,'Откликов пока нет');
  if(p==='payments')return renderList(box,'getPayments','payments',renderPay,'Оплат пока нет');
  if(p==='products')return renderProducts(box);
  if(p==='newsletter')return renderNewsletter(box);
}

/* KPI-иконки (только ₽, без $ / USD) */
function icoR(){return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 21V3h6a5 5 0 0 1 0 10H6M3 13h10M3 17h10"/></svg>'}
function icoC(){return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="7" r="3.5"/><path d="M2 21c0-3.5 3-6 7-6s7 2.5 7 6"/></svg>'}
function icoM(){return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg>'}
function icoV(){return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7S1 12 1 12z"/><circle cx="12" cy="12" r="3"/></svg>'}
function icoP(){return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>'}
function icoTr(){return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 17l6-6 4 4 8-8M14 7h7v7"/></svg>'}

/* ========== DASHBOARD ========== */
async function renderDash(box,silent){
  const d=await api('admin_dashboard');
  if(!d.ok){box.innerHTML='<div class="empty">Не удалось загрузить: '+esc(d.error||'')+'</div>';return}
  markUpd();
  const kpi=(n,l,ico,delta,dCls)=>`<div class="kpi"><div class="kpi-ico">${ico}</div><div class="kpi-n">${n}</div><div class="kpi-l">${l}</div>${delta?`<div class="kpi-d ${dCls||''}">${delta}</div>`:''}</div>`;
  const gr=num(d.mrr_growth);
  const grStr = (num(d.mrr_prev)>0) ? ((gr>=0?'+':'')+gr+'% к прошлому') : (num(d.mrr)>0 ? 'Первый месяц' : '');
  const grCls = num(d.mrr_prev)>0 ? (gr>=0?'up':'dn') : 'mut';
  const todayHtml = num(d.rev_today)>0 ? rub(d.rev_today) : '<span style="color:var(--w3)">—</span>';
  const convDelta = num(d.clients_total)>0 ? (num(d.conversion)+'% конверсия') : 'Копим статистику';
  const convCls   = num(d.clients_total)>0 ? '' : 'mut';
  const retBlock = (num(d.retention_7d_base)>0 || num(d.retention_30d_base)>0) ? `
      ${num(d.retention_7d_base)>0?kpi(num(d.retention_7d)+'%','Retention 7d',icoP(),'из '+num(d.retention_7d_base)):''}
      ${num(d.retention_30d_base)>0?kpi(num(d.retention_30d)+'%','Retention 30d',icoP(),'из '+num(d.retention_30d_base)):''}
    `:`
      ${kpi('<span style="color:var(--w3)">—</span>','Retention',icoP(),'Копим статистику','mut')}
    `;
  box.innerHTML=`<div class="section">
    <div class="kpis">
      ${kpi(rub(d.mrr),'MRR · 30 дней',icoR(),grStr,grCls)}
      ${kpi(rub(d.arr),'ARR · прогноз (×12)',icoTr())}
      ${kpi(todayHtml,'Сегодня',icoR(), num(d.rev_today)===0?'Сегодня оплат нет':'', num(d.rev_today)===0?'mut':'')}
      ${kpi(nice(d.dau),'DAU',icoV(),nice(d.mau)+' MAU')}
      ${kpi(nice(d.reg_today),'Регистраций сегодня',icoC(),nice(d.reg_week)+' за неделю')}
      ${kpi(num(d.clients_paid)+'/'+num(d.clients_total),'Оплатили',icoM(),convDelta,convCls)}
