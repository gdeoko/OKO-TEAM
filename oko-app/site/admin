async function mpSubmit(){
  const email=document.getElementById('mpEmail').value.trim().toLowerCase();
  const name=document.getElementById('mpName').value.trim();
  const amount=parseInt(document.getElementById('mpAmount').value||'0',10);
  const product=document.getElementById('mpProduct').value;
  const method=document.getElementById('mpMethod').value;
  const tx_id=document.getElementById('mpTxId').value.trim();
  const comment=document.getElementById('mpComment').value.trim();
  const ref=document.getElementById('mpRef').value.trim();
  const res=document.getElementById('mpRes');
  if(!email||!name||amount<=0){res.style.display='block';res.className='mp-res err';res.textContent='Заполни email, имя и сумму > 0';return}
  res.style.display='block';res.className='mp-res';res.textContent='Провожу…';
  const r=await apiPost('admin_manual_payment',{email,name,amount,product,method,tx_id,comment,ref});
  if(r.ok){
    res.className='mp-res ok';
    res.textContent='Готово. Payment #'+r.payment_id+' · '+rub(amount)+(num(r.partner_amount)>0?' · партнёру '+rub(r.partner_amount):'');
    ['mpEmail','mpName','mpAmount','mpTxId','mpComment'].forEach(id=>document.getElementById(id).value='');
    document.getElementById('mpRef').value='';
  }else{
    res.className='mp-res err';
    res.textContent='Ошибка: '+(r.error||'сеть');
  }
}

