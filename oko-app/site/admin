<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>OKO TEAM — Админ</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@600;700;900&family=Onest:wght@400;500;600;700&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<style>
*{margin:0;padding:0;box-sizing:border-box}
:root{--lime:#9AFF00;--bg:#050505;--card:rgba(255,255,255,0.035);--bd:rgba(255,255,255,0.08);--bdl:rgba(154,255,0,0.18);--w2:rgba(255,255,255,0.72);--w3:rgba(255,255,255,0.42);--w4:rgba(255,255,255,0.2);--red:#ff6b6b;--amber:#ffb800;--blu:#78b4ff}
html{scroll-behavior:smooth}
body{background:var(--bg);color:#fff;font-family:'Onest',sans-serif;min-height:100vh;overflow-x:hidden;line-height:1.5}
canvas#bg{position:fixed;inset:0;z-index:0;pointer-events:none}
.uni{font-family:'Unbounded',sans-serif}
.lime{color:var(--lime)}
.red{color:var(--red)}
.amber{color:var(--amber)}
a{color:inherit;text-decoration:none}
.hide{display:none!important}
.login{position:fixed;inset:0;z-index:50;display:flex;align-items:center;justify-content:center;padding:24px;background:var(--bg)}
.login-box{position:relative;z-index:2;width:100%;max-width:360px;background:var(--card);border:1px solid var(--bdl);border-radius:22px;padding:34px 28px;backdrop-filter:blur(20px);text-align:center}
.login-logo{font-family:'Unbounded';font-size:24px;font-weight:900;margin-bottom:6px}
.login-sub{font-size:11px;color:var(--lime);letter-spacing:3px;text-transform:uppercase;margin-bottom:26px}
.inp,textarea.inp{width:100%;background:rgba(255,255,255,0.05);border:1px solid var(--bd);border-radius:13px;padding:14px 16px;color:#fff;font-family:'Onest';font-size:15px;outline:none;transition:.2s;resize:vertical}
.inp:focus{border-color:var(--lime)}
.btn{width:100%;background:var(--lime);color:#000;border:none;border-radius:13px;padding:14px;font-family:'Unbounded';font-weight:800;font-size:13px;cursor:pointer;margin-top:12px;transition:.2s}
.btn:hover{opacity:.88;transform:translateY(-1px)}
.btn.ghost{background:rgba(255,255,255,0.05);color:#fff;border:1px solid var(--bd)}
.btn.danger{background:rgba(255,107,107,0.14);color:var(--red);border:1px solid rgba(255,107,107,0.3)}
.login-err{color:#ff6b6b;font-size:12px;margin-top:12px;min-height:14px}
.app{position:relative;z-index:1;display:flex;min-height:100vh}
.side{position:fixed;top:0;left:0;bottom:0;width:230px;background:rgba(8,8,8,0.86);backdrop-filter:blur(22px);border-right:1px solid var(--bd);padding:22px 14px;display:flex;flex-direction:column;gap:4px;z-index:30;transition:transform .28s;overflow-y:auto}
.side-logo{display:flex;align-items:center;gap:10px;padding:6px 10px 20px}
.side-logo .n{font-family:'Unbounded';font-size:17px;font-weight:900}
.nav-i{display:flex;align-items:center;gap:11px;padding:11px 13px;border-radius:12px;color:var(--w3);font-size:13px;font-weight:600;cursor:pointer;transition:.18s;border:1px solid transparent}
.nav-i svg{width:18px;height:18px;flex-shrink:0}
.nav-i:hover{color:#fff;background:rgba(255,255,255,0.04)}
.nav-i.on{color:var(--lime);background:rgba(154,255,0,0.07);border-color:var(--bdl)}
.nav-sp{flex:1}
.nav-live-dot{width:6px;height:6px;border-radius:50%;background:var(--lime);box-shadow:0 0 8px var(--lime);animation:pulse 1.6s infinite;margin-left:auto}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.3}}
.main{flex:1;margin-left:230px;padding:22px 26px 60px;max-width:100%}
.topbar{display:flex;align-items:center;justify-content:space-between;margin-bottom:22px;gap:12px}
.topbar-t{font-family:'Unbounded';font-size:22px;font-weight:900}
.topbar-s{font-size:12px;color:var(--w3);margin-top:2px}
.topbar-r{display:flex;align-items:center;gap:8px}
.ham{display:none;background:rgba(255,255,255,0.05);border:1px solid var(--bd);color:#fff;width:42px;height:42px;border-radius:11px;font-size:19px;cursor:pointer}
.side-x{display:none;position:absolute;top:16px;right:14px;background:none;border:none;color:var(--w3);font-size:22px;cursor:pointer}
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:12px;margin-bottom:20px}
.kpi{background:var(--card);border:1px solid var(--bd);border-radius:16px;padding:18px;transition:.25s;position:relative;overflow:hidden}
.kpi:hover{border-color:var(--bdl);transform:translateY(-2px)}
.kpi-n{font-family:'Unbounded';font-size:26px;font-weight:900;color:var(--lime);line-height:1.05;word-break:break-word}
.kpi-l{font-size:11px;color:var(--w3);margin-top:7px;text-transform:uppercase;letter-spacing:.5px}
.kpi-d{font-size:11px;margin-top:4px;font-weight:700}
.kpi-d.up{color:var(--lime)}
.kpi-d.dn{color:var(--red)}
.kpi-ico{position:absolute;top:14px;right:14px;color:rgba(154,255,0,0.22)}
.cards-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:12px}
.card{background:var(--card);border:1px solid var(--bd);border-radius:16px;padding:16px 18px;transition:.22s}
.card:hover{border-color:var(--bdl)}
.card-h{font-family:'Unbounded';font-size:13px;font-weight:700;margin-bottom:12px;display:flex;align-items:center;gap:8px;color:var(--w2);text-transform:uppercase;letter-spacing:.5px}
.card-h .live{width:6px;height:6px;border-radius:50%;background:var(--lime);box-shadow:0 0 8px var(--lime);animation:pulse 1.6s infinite}
.chart-card{background:var(--card);border:1px solid var(--bd);border-radius:18px;padding:18px}
.charts{display:grid;grid-template-columns:1.4fr 1fr;gap:14px;margin-bottom:20px}
.chart-wrap{position:relative;height:230px}
.lc{background:var(--card);border:1px solid var(--bd);border-radius:14px;padding:14px 16px;margin-bottom:10px;transition:.2s;cursor:pointer}
.lc:hover{border-color:var(--bdl);background:rgba(154,255,0,0.03)}
.lc-top{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:6px}
.lc-name{font-weight:700;font-size:15px}
.lc-meta{font-size:12px;color:var(--w3);display:flex;flex-wrap:wrap;gap:6px 14px;align-items:center}
.lc-meta a{color:var(--lime)}
.badge{font-size:10px;font-weight:800;padding:4px 10px;border-radius:20px;text-transform:uppercase;letter-spacing:.5px;white-space:nowrap}
.b-new{background:rgba(255,255,255,0.08);color:var(--w2)}
.b-deal,.b-paid{background:rgba(154,255,0,0.14);color:var(--lime)}
.b-wait{background:rgba(255,180,0,0.14);color:#ffb800}
.b-lead{background:rgba(120,180,255,0.14);color:var(--blu)}
.b-partner{background:rgba(255,122,60,0.14);color:#ff7a3c}
.b-response{background:rgba(168,85,247,0.14);color:#a855f7}
.b-anketa{background:rgba(52,211,153,0.14);color:#34d399}
.b-refund,.b-banned{background:rgba(255,107,107,0.14);color:var(--red)}
.row-tools{display:flex;gap:10px;margin-bottom:16px;flex-wrap:wrap}
.row-tools .inp{flex:1;min-width:180px}
.sel{background:rgba(255,255,255,0.05);border:1px solid var(--bd);border-radius:13px;padding:13px 14px;color:#fff;font-family:'Onest';font-size:14px;outline:none}
.empty{padding:40px 20px;text-align:center;color:var(--w3);font-size:14px}
.mini-btn{background:rgba(154,255,0,0.08);border:1px solid var(--bdl);color:var(--lime);border-radius:10px;padding:8px 14px;font-size:12px;font-weight:700;cursor:pointer;font-family:'Onest';transition:.15s}
.mini-btn:hover{background:rgba(154,255,0,0.14)}
.mini-btn.ghost{background:rgba(255,255,255,0.04);border-color:var(--bd);color:var(--w2)}
.mini-btn.ghost:hover{background:rgba(255,255,255,0.08)}
.mini-btn.dngr{background:rgba(255,107,107,0.1);border-color:rgba(255,107,107,0.3);color:var(--red)}
.mini-btn.dngr:hover{background:rgba(255,107,107,0.18)}
.mini-btn.warn{background:rgba(255,184,0,0.1);border-color:rgba(255,184,0,0.3);color:var(--amber)}
.mini-btn.warn:hover{background:rgba(255,184,0,0.18)}
.detail{margin-top:12px;padding-top:12px;border-top:1px solid var(--bd);font-size:13px;color:var(--w2)}
.detail b{color:#fff}
.detail .btnrow{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}
.dlg{background:rgba(255,255,255,0.03);border-radius:10px;padding:8px 12px;margin-top:6px;font-size:12.5px}
.dlg .r{color:var(--lime);font-weight:700;font-size:11px;text-transform:uppercase;margin-right:6px}
.insight{display:flex;gap:12px;background:rgba(154,255,0,0.04);border:1px solid var(--bdl);border-radius:14px;padding:14px 16px;margin-bottom:10px}
.insight-ico{color:var(--lime);flex-shrink:0}
.insight b{color:#fff}
.insight span{color:var(--w3);font-size:13px}
.section{animation:rise .4s ease}
@keyframes rise{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
.spin{width:26px;height:26px;border:3px solid rgba(154,255,0,0.2);border-top-color:var(--lime);border-radius:50%;animation:sp 1s linear infinite;margin:40px auto}
@keyframes sp{to{transform:rotate(360deg)}}
/* Live newsfeed */
.feed-row{display:flex;gap:12px;padding:12px 14px;border-radius:11px;background:rgba(255,255,255,0.02);border:1px solid var(--bd);margin-bottom:6px;transition:.2s;align-items:center}
.feed-row:hover{background:rgba(154,255,0,0.03);border-color:var(--bdl)}
.feed-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0}
.feed-dot.lead{background:var(--blu);box-shadow:0 0 6px var(--blu)}
.feed-dot.payment{background:var(--lime);box-shadow:0 0 8px var(--lime)}
.feed-dot.deal{background:var(--lime)}
.feed-dot.partner{background:#ff7a3c;box-shadow:0 0 6px #ff7a3c}
.feed-dot.response{background:#a855f7}
.feed-dot.anketa{background:#34d399}
.feed-body{flex:1;min-width:0}
.feed-t{font-size:13.5px;color:#fff;font-weight:600}
.feed-m{font-size:11.5px;color:var(--w3);margin-top:2px}
.feed-age{font-size:11px;color:var(--w4);white-space:nowrap;font-variant-numeric:tabular-nums}
/* Agent panel */
.agent-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:12px}
.agent-card{background:var(--card);border:1px solid var(--bd);border-radius:16px;padding:16px;transition:.2s;position:relative;overflow:hidden}
.agent-card:hover{border-color:var(--bdl)}
.agent-card::before{content:'';position:absolute;left:0;top:0;bottom:0;width:3px;background:var(--ac,#666)}
.agent-h{display:flex;align-items:center;gap:10px;margin-bottom:10px}
.agent-av{width:36px;height:36px;border-radius:10px;background:rgba(154,255,0,0.08);display:flex;align-items:center;justify-content:center;font-family:'Unbounded';font-weight:900;font-size:13px;color:var(--ac,#9AFF00)}
.agent-nm{font-weight:700;font-size:14px}
.agent-en{font-size:10px;color:var(--w3);text-transform:uppercase;letter-spacing:.5px;margin-top:1px}
.agent-t{font-size:12.5px;color:var(--w2);margin-bottom:10px;min-height:32px;line-height:1.4}
.agent-b{display:flex;align-items:center;justify-content:space-between;gap:8px;font-size:11px;color:var(--w3)}
.agent-progress{height:4px;background:rgba(255,255,255,0.06);border-radius:2px;overflow:hidden;margin-top:8px}
.agent-progress-b{height:100%;background:var(--ac,#9AFF00);transition:width .3s ease}
.stat-bar{display:flex;gap:10px;background:var(--card);border:1px solid var(--bd);border-radius:14px;padding:14px 18px;margin-bottom:14px;flex-wrap:wrap;align-items:center}
.stat-bar span{font-size:12px;color:var(--w3)}
.stat-bar b{color:#fff;font-weight:700}
/* Modal */
.modal{position:fixed;inset:0;z-index:60;background:rgba(0,0,0,0.72);display:flex;align-items:center;justify-content:center;padding:20px;backdrop-filter:blur(6px)}
.modal-b{max-width:520px;width:100%;background:#0a0a0a;border:1px solid var(--bdl);border-radius:20px;padding:24px;max-height:90vh;overflow-y:auto}
.modal-t{font-family:'Unbounded';font-size:16px;font-weight:900;margin-bottom:12px}
.modal-close{background:none;border:none;color:var(--w3);float:right;font-size:20px;cursor:pointer}
@media(max-width:860px){
  .side{transform:translateX(-100%);width:250px}
  .side.open{transform:none}
  .side-x{display:block}
  .main{margin-left:0;padding:16px 14px 50px}
  .ham{display:block}
  .charts{grid-template-columns:1fr}
  .topbar-t{font-size:19px}
  .kpi-n{font-size:22px}
}
</style>
</head>
<body>
<canvas id="bg"></canvas>
<div class="login" id="login">
  <div class="login-box">
    <div class="login-logo uni">ОКО<span class="lime"> TEAM</span></div>
    <div class="login-sub">Админ-панель</div>
    <input class="inp" id="pw" type="password" placeholder="Пароль" autocomplete="current-password">
    <button class="btn" onclick="doLogin()">Войти</button>
    <div class="login-err" id="loginErr"></div>
  </div>
</div>
<div class="app hide" id="app">
  <aside class="side" id="side">
    <button class="side-x" onclick="toggleSide()">✕</button>
    <div class="side-logo">
      <svg width="30" height="30" viewBox="0 0 40 40" fill="none"><path d="M4 20 C10 8 30 8 36 20 C30 32 10 32 4 20Z" stroke="#9AFF00" stroke-width="2.5"/><circle cx="20" cy="20" r="6" stroke="#9AFF00" stroke-width="2.5"/><circle cx="20" cy="20" r="2.5" fill="#9AFF00"/></svg>
      <div class="n uni">ОКО<span class="lime"> TEAM</span></div>
    </div>
    <div class="nav-i on" data-p="dashboard" onclick="go('dashboard')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg>Дашборд<span class="nav-live-dot"></span></div>
    <div class="nav-i" data-p="clients" onclick="go('clients')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="7" r="3.5"/><path d="M2 21c0-3.5 3-6 7-6s7 2.5 7 6"/><path d="M17 4.5a3.5 3.5 0 0 1 0 6.5M22 21c0-2.8-1.6-5-4-5.7"/></svg>Клиенты</div>
    <div class="nav-i" data-p="feed" onclick="go('feed')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>Live-лента</div>
    <div class="nav-i" data-p="agents" onclick="go('agents')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/><circle cx="9" cy="10" r="1"/><circle cx="15" cy="10" r="1"/></svg>Агенты<span class="nav-live-dot"></span></div>
    <div class="nav-i" data-p="partners" onclick="go('partners')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>Партнёры</div>
    <div class="nav-i" data-p="moderation" onclick="go('moderation')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>Модерация</div>
    <div class="nav-i" data-p="finance" onclick="go('finance')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 1v22M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>Финансы</div>
    <div class="nav-i" data-p="anketas" onclick="go('anketas')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/></svg>Анкеты</div>
    <div class="nav-i" data-p="dialogs" onclick="go('dialogs')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H8l-4 4V5a2 2 0 0 1 2-2h13a2 2 0 0 1 2 2z"/></svg>Диалоги</div>
    <div class="nav-i" data-p="deals" onclick="go('deals')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 7 12 3 4 7v10l8 4 8-4z"/></svg>Сделки</div>
    <div class="nav-i" data-p="vacancies" onclick="go('vacancies')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>Вакансии</div>
    <div class="nav-i" data-p="responses" onclick="go('responses')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 2 11 13M22 2l-7 20-4-9-9-4z"/></svg>Отклики</div>
    <div class="nav-i" data-p="payments" onclick="go('payments')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg>Оплаты</div>
    <div class="nav-i" data-p="products" onclick="go('products')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 7 12 3 4 7v10l8 4 8-4z"/><path d="M12 3v18M4 7l8 4 8-4"/></svg>Продукты</div>
    <div class="nav-i" data-p="newsletter" onclick="go('newsletter')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 6 10 7 10-7"/></svg>Рассылка</div>
    <div class="nav-sp"></div>
    <div class="nav-i" onclick="location.href='/ai-team'"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2c3 3 3 17 0 20M12 2c-3 3-3 17 0 20"/></svg>3D-Штаб</div>
    <div class="nav-i" onclick="logout()"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></svg>Выйти</div>
  </aside>
  <main class="main">
    <div class="topbar">
      <div style="display:flex;align-items:center;gap:12px">
        <button class="ham" onclick="toggleSide()">☰</button>
        <div><div class="topbar-t" id="pageTitle">Дашборд</div><div class="topbar-s" id="pageSub">Обзор системы OKO</div></div>
      </div>
      <div class="topbar-r">
        <span id="lastUpd" style="font-size:11px;color:var(--w3)"></span>
        <button class="mini-btn ghost" onclick="loadPage(cur)">↻ Обновить</button>
      </div>
    </div>
    <div id="content"><div class="spin"></div></div>
  </main>
</div>
<div id="modalWrap"></div>
<script>
const API='/api.php';
let adminKey=localStorage.getItem('okoKey')||'';
let cur='dashboard';
let charts={};
let refreshTimer=null;
const REFRESH_MS={dashboard:30000,feed:15000,agents:15000,partners:60000,moderation:60000};

(function bg(){
  const c=document.getElementById('bg'),x=c.getContext('2d');let W,H,ps=[];
  function rs(){W=c.width=innerWidth;H=c.height=innerHeight}rs();addEventListener('resize',rs);
  for(let i=0;i<55;i++)ps.push({x:Math.random()*innerWidth,y:Math.random()*innerHeight,vx:(Math.random()-.5)*.25,vy:(Math.random()-.5)*.25,r:Math.random()*1.5+.4,a:Math.random()});
  (function d(){x.clearRect(0,0,W,H);ps.forEach(p=>{p.x+=p.vx;p.y+=p.vy;if(p.x<0)p.x=W;if(p.x>W)p.x=0;if(p.y<0)p.y=H;if(p.y>H)p.y=0;x.beginPath();x.arc(p.x,p.y,p.r,0,7);x.fillStyle='rgba(154,255,0,'+(p.a*.35)+')';x.fill()});ps.forEach((p,i)=>ps.slice(i+1).forEach(q=>{const dd=Math.hypot(p.x-q.x,p.y-q.y);if(dd<115){x.beginPath();x.moveTo(p.x,p.y);x.lineTo(q.x,q.y);x.strokeStyle='rgba(154,255,0,'+(.05*(1-dd/115))+')';x.lineWidth=.5;x.stroke()}}));requestAnimationFrame(d)})();
})();

