<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>OKO TEAM — Админ</title>
<link rel="icon" type="image/png" href="/oko-logo-256.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@600;700;900&family=Onest:wght@400;500;600;700&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<style>
*{margin:0;padding:0;box-sizing:border-box;min-width:0}
:root{
  --lime:#9AFF00;--bg:#050505;--panel:#0a0a0a;
  --card:rgba(255,255,255,0.035);--bd:rgba(255,255,255,0.08);--bdl:rgba(154,255,0,0.18);
  --w1:#fff;--w2:rgba(255,255,255,0.72);--w3:rgba(255,255,255,0.42);--w4:rgba(255,255,255,0.2);
  --red:#ff6b6b;--amber:#ffb800;--blu:#78b4ff;--r:12px
}
:root[data-theme="light"]{
  --bg:#f6f7f5;--panel:#fff;--card:rgba(0,0,0,0.03);--bd:rgba(0,0,0,0.08);--bdl:rgba(80,140,0,0.28);
  --w1:#0b0b0b;--w2:rgba(0,0,0,0.75);--w3:rgba(0,0,0,0.5);--w4:rgba(0,0,0,0.22);
}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--w1);font-family:'Onest',sans-serif;min-height:100vh;overflow-x:hidden;line-height:1.5}
canvas#bg{position:fixed;inset:0;z-index:0;pointer-events:none;opacity:.85}
:root[data-theme="light"] canvas#bg{opacity:.35}
.uni{font-family:'Unbounded',sans-serif}
.lime{color:var(--lime)}
.red{color:var(--red)}
.amber{color:var(--amber)}
.blu{color:var(--blu)}
a{color:inherit;text-decoration:none}
.hide{display:none!important}
.nowrap{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
/* login */
.login{position:fixed;inset:0;z-index:50;display:flex;align-items:center;justify-content:center;padding:24px;background:var(--bg)}
.login-box{position:relative;z-index:2;width:100%;max-width:360px;background:var(--card);border:1px solid var(--bdl);border-radius:22px;padding:34px 28px;backdrop-filter:blur(20px);text-align:center}
.login-img{width:72px;height:72px;object-fit:contain;margin:0 auto 12px;display:block;filter:drop-shadow(0 0 14px rgba(154,255,0,.35))}
.login-logo{font-family:'Unbounded';font-size:22px;font-weight:900;margin-bottom:4px}
.login-sub{font-size:11px;color:var(--lime);letter-spacing:3px;text-transform:uppercase;margin-bottom:22px}
.inp,textarea.inp{width:100%;background:rgba(255,255,255,0.05);border:1px solid var(--bd);border-radius:var(--r);padding:12px 14px;color:var(--w1);font-family:'Onest';font-size:14px;outline:none;transition:.2s;resize:vertical}
:root[data-theme="light"] .inp,:root[data-theme="light"] textarea.inp{background:rgba(0,0,0,0.03)}
.inp:focus{border-color:var(--lime)}
.btn{width:100%;background:var(--lime);color:#000;border:none;border-radius:var(--r);padding:13px;font-family:'Unbounded';font-weight:800;font-size:13px;cursor:pointer;margin-top:12px;transition:.2s;letter-spacing:.3px}
.btn:hover{opacity:.9;transform:translateY(-1px)}
.btn.ghost{background:rgba(255,255,255,0.05);color:var(--w1);border:1px solid var(--bd)}
:root[data-theme="light"] .btn.ghost{background:rgba(0,0,0,0.04)}
.btn.danger{background:rgba(255,107,107,0.14);color:var(--red);border:1px solid rgba(255,107,107,0.3)}
.login-err{color:#ff6b6b;font-size:12px;margin-top:10px;min-height:14px}
/* layout */
.app{position:relative;z-index:1;display:flex;min-height:100vh}
.side{position:fixed;top:0;left:0;bottom:0;width:224px;background:rgba(8,8,8,0.86);backdrop-filter:blur(22px);border-right:1px solid var(--bd);padding:18px 12px;display:flex;flex-direction:column;gap:3px;z-index:30;transition:transform .28s;overflow-y:auto}
:root[data-theme="light"] .side{background:rgba(255,255,255,0.9)}
.side-logo{display:flex;align-items:center;gap:10px;padding:6px 8px 16px}
.side-logo img{width:38px;height:38px;object-fit:contain;filter:drop-shadow(0 0 10px rgba(154,255,0,.5));flex-shrink:0}
.side-logo .n{font-family:'Unbounded';font-size:16px;font-weight:900;letter-spacing:.5px}
.nav-i{display:flex;align-items:center;gap:11px;padding:10px 12px;border-radius:var(--r);color:var(--w3);font-size:13px;font-weight:600;cursor:pointer;transition:.18s;border:1px solid transparent;overflow:hidden}
.nav-i svg{width:17px;height:17px;flex-shrink:0}
.nav-i .lbl{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.nav-i:hover{color:var(--w1);background:rgba(255,255,255,0.04)}
:root[data-theme="light"] .nav-i:hover{background:rgba(0,0,0,0.04)}
.nav-i.on{color:var(--lime);background:rgba(154,255,0,0.07);border-color:var(--bdl)}
.nav-sp{flex:1}
.nav-live-dot{width:6px;height:6px;border-radius:50%;background:var(--lime);box-shadow:0 0 8px var(--lime);animation:pulse 1.6s infinite;flex-shrink:0}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.3}}
.main{flex:1;margin-left:224px;padding:18px 22px 60px;max-width:100%;min-width:0}
.topbar{display:flex;align-items:center;justify-content:space-between;margin-bottom:18px;gap:12px}
.topbar-t{font-family:'Unbounded';font-size:20px;font-weight:900;line-height:1.15}
.topbar-s{font-size:12px;color:var(--w3);margin-top:2px}
.topbar-r{display:flex;align-items:center;gap:8px}
.ham{display:none;background:rgba(255,255,255,0.05);border:1px solid var(--bd);color:var(--w1);width:40px;height:40px;border-radius:11px;cursor:pointer;align-items:center;justify-content:center}
.ham svg{width:18px;height:18px}
.side-x{display:none;position:absolute;top:12px;right:12px;background:none;border:none;color:var(--w3);cursor:pointer;padding:8px}
/* KPIs */
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:12px;margin-bottom:18px}
.kpi{background:var(--card);border:1px solid var(--bd);border-radius:var(--r);padding:14px;transition:.25s;position:relative;overflow:hidden;min-width:0}
.kpi:hover{border-color:var(--bdl);transform:translateY(-2px)}
.kpi-n{font-family:'Unbounded';font-size:24px;font-weight:900;color:var(--lime);line-height:1.05;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;padding-right:32px}
.kpi-l{font-size:10.5px;color:var(--w3);margin-top:7px;text-transform:uppercase;letter-spacing:.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.kpi-d{font-size:11px;margin-top:4px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.kpi-d.up{color:var(--lime)}
.kpi-d.dn{color:var(--red)}
.kpi-d.mut{color:var(--w3);font-weight:600}
.kpi-ico{position:absolute;top:12px;right:12px;color:rgba(154,255,0,0.22);pointer-events:none}
.kpi-ico svg{width:20px;height:20px}
.tick-metric{font-family:'Unbounded';font-size:40px;font-weight:900;color:var(--lime);line-height:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
/* card */
.card{background:var(--card);border:1px solid var(--bd);border-radius:var(--r);padding:14px;transition:.22s;min-width:0;overflow:hidden}
.card:hover{border-color:var(--bdl)}
.card-h{font-family:'Unbounded';font-size:12px;font-weight:700;margin-bottom:10px;display:flex;align-items:center;gap:8px;color:var(--w2);text-transform:uppercase;letter-spacing:.5px;min-width:0}
.card-h .live{width:6px;height:6px;border-radius:50%;background:var(--lime);box-shadow:0 0 8px var(--lime);animation:pulse 1.6s infinite;flex-shrink:0}
.card-h .h-lbl{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.chart-card{background:var(--card);border:1px solid var(--bd);border-radius:var(--r);padding:14px;min-width:0;overflow:hidden}
.charts{display:grid;grid-template-columns:1.4fr 1fr;gap:12px;margin-bottom:18px}
.chart-wrap{position:relative;height:230px}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:16px 0}
.lc{background:var(--card);border:1px solid var(--bd);border-radius:var(--r);padding:12px 14px;margin-bottom:8px;transition:.2s;cursor:pointer;min-width:0;overflow:hidden}
.lc:hover{border-color:var(--bdl);background:rgba(154,255,0,0.03)}
.lc-top{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:6px;min-width:0}
.lc-name{font-weight:700;font-size:14.5px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0;flex:1}
.lc-meta{font-size:12px;color:var(--w3);display:flex;flex-wrap:wrap;gap:5px 13px;align-items:center;min-width:0}
.lc-meta a{color:var(--lime)}
.badge{font-size:10px;font-weight:800;padding:4px 10px;border-radius:20px;text-transform:uppercase;letter-spacing:.4px;white-space:nowrap;flex-shrink:0}
.b-new{background:rgba(255,255,255,0.08);color:var(--w2)}
.b-deal,.b-paid{background:rgba(154,255,0,0.14);color:var(--lime)}
.b-wait{background:rgba(255,180,0,0.14);color:var(--amber)}
.b-lead{background:rgba(120,180,255,0.14);color:var(--blu)}
.b-partner{background:rgba(255,122,60,0.14);color:#ff7a3c}
.b-response{background:rgba(168,85,247,0.14);color:#a855f7}
.b-anketa{background:rgba(52,211,153,0.14);color:#34d399}
.b-refund,.b-banned{background:rgba(255,107,107,0.14);color:var(--red)}
.b-vnim{background:rgba(255,180,0,0.18);color:var(--amber)}
.b-spyash{background:rgba(255,255,255,0.06);color:var(--w3)}
.b-otkaz{background:rgba(255,107,107,0.12);color:var(--red)}
.steps{display:flex;gap:4px;align-items:center;margin:9px 0 3px;flex-wrap:wrap}
.step{flex:1 1 34px;min-width:26px;height:5px;border-radius:3px;background:rgba(255,255,255,0.09)}
.step.on{background:var(--lime)}
.step-lbl{display:flex;gap:4px;flex-wrap:wrap;font-size:10px;color:var(--w3);letter-spacing:.2px}
.step-lbl span{flex:1 1 34px;min-width:26px;text-align:center}
.step-lbl span.on{color:var(--lime);font-weight:700}
.note{background:rgba(255,255,255,0.04);border-left:2px solid var(--lime);padding:7px 10px;border-radius:0 6px 6px 0;margin:6px 0;font-size:12.5px;line-height:1.5}
.note .who{font-size:10.5px;color:var(--w3);text-transform:uppercase;letter-spacing:.4px;margin-bottom:2px}
.agr{display:flex;justify-content:space-between;gap:10px;padding:7px 0;border-bottom:1px solid rgba(255,255,255,0.06);font-size:12.5px;flex-wrap:wrap}
.agr:last-child{border-bottom:none}
.stale{background:rgba(255,180,0,0.12);color:var(--amber);padding:8px 12px;border-radius:8px;font-size:12.5px;margin-bottom:12px}
.row-tools{display:flex;gap:10px;margin-bottom:14px;flex-wrap:wrap;min-width:0}
.row-tools .inp{flex:1;min-width:180px}
.sel{background:rgba(255,255,255,0.05);border:1px solid var(--bd);border-radius:var(--r);padding:12px 14px;color:var(--w1);font-family:'Onest';font-size:14px;outline:none;min-width:0}
:root[data-theme="light"] .sel{background:rgba(0,0,0,0.03)}
.empty{padding:36px 18px;text-align:center;color:var(--w3);font-size:13.5px}
.chip{display:inline-flex;align-items:center;gap:6px;font-size:11px;font-weight:700;padding:5px 10px;border-radius:20px;background:rgba(154,255,0,0.09);color:var(--lime);border:1px solid var(--bdl);letter-spacing:.3px;white-space:nowrap}
.chip.mut{background:rgba(255,255,255,0.05);color:var(--w2);border-color:var(--bd)}
.mini-btn{background:rgba(154,255,0,0.08);border:1px solid var(--bdl);color:var(--lime);border-radius:10px;padding:7px 12px;font-size:12px;font-weight:700;cursor:pointer;font-family:'Onest';transition:.15s;display:inline-flex;align-items:center;gap:6px;white-space:nowrap}
.mini-btn svg{width:13px;height:13px}
.mini-btn:hover{background:rgba(154,255,0,0.14)}
.mini-btn.ghost{background:rgba(255,255,255,0.04);border-color:var(--bd);color:var(--w2)}
:root[data-theme="light"] .mini-btn.ghost{background:rgba(0,0,0,0.04)}
.mini-btn.ghost:hover{background:rgba(255,255,255,0.08)}
.mini-btn.dngr{background:rgba(255,107,107,0.1);border-color:rgba(255,107,107,0.3);color:var(--red)}
.mini-btn.dngr:hover{background:rgba(255,107,107,0.18)}
.mini-btn.warn{background:rgba(255,184,0,0.1);border-color:rgba(255,184,0,0.3);color:var(--amber)}
.mini-btn.warn:hover{background:rgba(255,184,0,0.18)}
.detail{margin-top:10px;padding-top:10px;border-top:1px solid var(--bd);font-size:13px;color:var(--w2)}
.detail b{color:var(--w1)}
.detail .btnrow{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}
.dlg{background:rgba(255,255,255,0.03);border-radius:9px;padding:8px 12px;margin-top:6px;font-size:12.5px;overflow:hidden;text-overflow:ellipsis}
:root[data-theme="light"] .dlg{background:rgba(0,0,0,0.03)}
.dlg .r{color:var(--lime);font-weight:700;font-size:11px;text-transform:uppercase;margin-right:6px}
.section{animation:rise .3s ease}
@keyframes rise{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
.spin{width:24px;height:24px;border:3px solid rgba(154,255,0,0.2);border-top-color:var(--lime);border-radius:50%;animation:sp 1s linear infinite;margin:40px auto}
@keyframes sp{to{transform:rotate(360deg)}}
/* Live feed */
.feed-row{display:flex;gap:12px;padding:11px 13px;border-radius:11px;background:rgba(255,255,255,0.02);border:1px solid var(--bd);margin-bottom:6px;transition:.2s;align-items:center;cursor:pointer;min-width:0;overflow:hidden}
:root[data-theme="light"] .feed-row{background:rgba(0,0,0,0.02)}
.feed-row:hover{background:rgba(154,255,0,0.03);border-color:var(--bdl)}
.feed-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0}
.feed-dot.lead{background:var(--blu);box-shadow:0 0 6px var(--blu)}
.feed-dot.payment{background:var(--lime);box-shadow:0 0 8px var(--lime)}
.feed-dot.deal{background:var(--lime)}
.feed-dot.partner{background:#ff7a3c;box-shadow:0 0 6px #ff7a3c}
.feed-dot.response{background:#a855f7}
.feed-dot.anketa{background:#34d399}
.feed-body{flex:1;min-width:0;overflow:hidden}
.feed-t{font-size:13px;color:var(--w1);font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.feed-m{font-size:11.5px;color:var(--w3);margin-top:2px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.feed-age{font-size:11px;color:var(--w4);white-space:nowrap;font-variant-numeric:tabular-nums;flex-shrink:0}
/* Agent panel */
.agent-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:12px}
.agent-card{background:var(--card);border:1px solid var(--bd);border-radius:var(--r);padding:14px;transition:.2s;position:relative;overflow:hidden;cursor:pointer;min-width:0}
.agent-card:hover{border-color:var(--bdl)}
.agent-card::before{content:'';position:absolute;left:0;top:0;bottom:0;width:3px;background:var(--ac,#666)}
.agent-h{display:flex;align-items:center;gap:10px;margin-bottom:10px;min-width:0}
.agent-av{width:34px;height:34px;border-radius:9px;background:rgba(154,255,0,0.08);display:flex;align-items:center;justify-content:center;font-family:'Unbounded';font-weight:900;font-size:12px;color:var(--ac,#9AFF00);flex-shrink:0}
.agent-nm{font-weight:700;font-size:13.5px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.agent-en{font-size:10px;color:var(--w3);text-transform:uppercase;letter-spacing:.5px;margin-top:1px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.agent-t{font-size:12.5px;color:var(--w2);margin-bottom:10px;min-height:32px;line-height:1.4;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}
.agent-b{display:flex;align-items:center;justify-content:space-between;gap:8px;font-size:11px;color:var(--w3)}
.agent-progress{height:4px;background:rgba(255,255,255,0.06);border-radius:2px;overflow:hidden;margin-top:8px}
.agent-progress-b{height:100%;background:var(--ac,#9AFF00);transition:width .3s ease}
.stat-bar{display:flex;gap:14px;background:var(--card);border:1px solid var(--bd);border-radius:var(--r);padding:12px 16px;margin-bottom:12px;flex-wrap:wrap;align-items:center;min-width:0}
.stat-bar span{font-size:12px;color:var(--w3);white-space:nowrap}
.stat-bar b{color:var(--w1);font-weight:700}
/* Modal */
.modal{position:fixed;inset:0;z-index:60;background:rgba(0,0,0,0.72);display:flex;align-items:center;justify-content:center;padding:16px;backdrop-filter:blur(6px)}
.modal-b{max-width:520px;width:100%;background:var(--panel);border:1px solid var(--bdl);border-radius:18px;padding:20px;max-height:90vh;overflow-y:auto}
.modal-t{font-family:'Unbounded';font-size:15px;font-weight:900;margin-bottom:12px;padding-right:26px;position:relative}
.modal-close{background:none;border:none;color:var(--w3);position:absolute;top:0;right:0;cursor:pointer;padding:2px 6px;font-size:20px;line-height:1}
/* Bulk bar */
.bulk-bar{position:sticky;top:0;background:var(--panel);border:1px solid var(--bdl);border-radius:var(--r);padding:10px 12px;margin-bottom:10px;display:flex;gap:10px;align-items:center;flex-wrap:wrap;z-index:10}
.bulk-bar b{color:var(--lime);font-weight:800}
.chk{width:16px;height:16px;border-radius:4px;border:1.5px solid var(--w3);background:transparent;display:inline-flex;align-items:center;justify-content:center;cursor:pointer;flex-shrink:0}
.chk.on{background:var(--lime);border-color:var(--lime)}
.chk.on svg{display:block}
.chk svg{display:none;width:11px;height:11px;color:#000}
.client-row{display:flex;align-items:center;gap:10px;min-width:0}
.client-av{width:36px;height:36px;border-radius:9px;display:flex;align-items:center;justify-content:center;font-family:'Unbounded';font-weight:900;font-size:11px;color:#000;flex-shrink:0}
.client-body{flex:1;min-width:0;overflow:hidden}
/* mp — manual payment form */
.mp-form{background:var(--card);border:1px solid var(--bd);border-radius:var(--r);padding:16px;max-width:640px}
.mp-form label{font-size:11px;color:var(--w3);text-transform:uppercase;letter-spacing:.5px;font-weight:600;display:block;margin-bottom:5px}
.mp-form .row{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:12px}
.mp-form .req::after{content:'*';color:var(--lime);margin-left:3px}
.mp-hint{font-size:11px;color:var(--w3);margin-top:4px}
.mp-res{margin-top:10px;padding:10px 12px;border-radius:var(--r);font-size:13px;font-weight:600}
.mp-res.ok{background:rgba(154,255,0,0.08);border:1px solid var(--bdl);color:var(--lime)}
.mp-res.err{background:rgba(255,107,107,0.08);border:1px solid rgba(255,107,107,0.3);color:var(--red)}
/* audio toggle */
.audio-tog{display:inline-flex;align-items:center;gap:6px;cursor:pointer;padding:7px 12px;border-radius:20px;border:1px solid var(--bd);background:var(--card);font-size:12px;color:var(--w2)}
.audio-tog.on{border-color:var(--bdl);color:var(--lime)}
.audio-tog svg{width:14px;height:14px}
/* theme button */
.theme-btn{width:36px;height:36px;border-radius:10px;border:1px solid var(--bd);background:var(--card);color:var(--w2);cursor:pointer;display:inline-flex;align-items:center;justify-content:center}
.theme-btn:hover{color:var(--lime);border-color:var(--bdl)}
.theme-btn svg{width:16px;height:16px}
/* responsive */
@media(max-width:860px){
  .side{transform:translateX(-100%);width:250px}
  .side.open{transform:none}
  .side-x{display:block}
  .main{margin-left:0;padding:14px 12px 50px}
  .ham{display:inline-flex}
  .charts,.grid2{grid-template-columns:1fr}
  .topbar-t{font-size:18px}
  .kpi-n{font-size:22px}
  .tick-metric{font-size:32px}
}
@media(max-width:400px){
  .kpis{grid-template-columns:1fr}
  .cards-grid{grid-template-columns:1fr!important}
  .tick-metric{font-size:28px}
  .mp-form .row{grid-template-columns:1fr}
}
</style>
</head>
<body>
<canvas id="bg"></canvas>
<div class="login" id="login">
