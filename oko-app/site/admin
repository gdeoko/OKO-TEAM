  const paid=document.getElementById('cPaid')?.value||'';
  let list=allClients.filter(c=>{
    const hay=((c.name||'')+' '+(c.email||'')+' '+(c.niche||'')+' '+(c.tg||'')+' '+(c.phone||'')).toLowerCase();
    if(paid!==''&&String(c.paid||0)!==paid)return false;
    return hay.includes(q)&&(!st||(c.status||'')===st);
  });
  const el=document.getElementById('clientList');
  el.innerHTML='<div style="font-size:12px;color:var(--w3);margin-bottom:8px">Показано: '+list.length+' из '+allClients.length+'</div>' + (list.map(c=>clientCard(c)).join('')||'<div class="empty">Ничего не найдено</div>');
