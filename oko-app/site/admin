/* ========== ПУТЬ КЛИЕНТА ==========
   Шесть отметок, статус, соглашения и заметки. Всё считает Python и кладёт
   снимок в data_runtime/admin_clients.json, тут только показ: одна правда,
   две витрины. Отметка «оплата» стоит только когда деньги есть в журнале
   выручки, поэтому «стадия оплаты, а платежа нет» видно как тревогу, а не как
   зелёную галочку. */
let progressData=[],progressSummary={};
// Заметки и снимок хранят время в unix-секундах, а общий ago() ждёт строку с
// датой: на числе он давал Invalid Date и показывал сырые «1755380000».
function agoU(сек){return сек?ago(new Date(Number(сек)*1000).toISOString()):''}
const СТАТУС_КЛАСС={'требует внимания':'b-vnim','активный':'b-paid','спящий':'b-spyash','завершён':'b-deal','отказ':'b-otkaz'};
async function renderProgress(box){
  box.innerHTML='<div class="spin" style="margin:40px auto"></div>';
  const d=await api('admin_progress');
  if(!d.ok){box.innerHTML='<div class="empty">Не загрузилось: '+esc(d.error||'')+'</div>';return}
  progressData=d.clients||[];progressSummary=d.summary||{};
  const с=progressSummary.по_статусам||{};
  // Возраст снимка на виду. Пустой список из-за упавшего сборщика и пустой
  // список из-за пустой базы выглядят одинаково, и молчать об этом нельзя.
  const возраст=d.age_sec;
  let шапка='';
  if(возраст<0)шапка='<div class="stale">Снимок ещё ни разу не собирался. Запусти: python3 -m tools.admin_snapshot</div>';
  else if(возраст>1800)шапка='<div class="stale">Снимок собран '+Math.round(возраст/60)+' мин назад, данные могли устареть</div>';
  const плитки=[['требует внимания','b-vnim'],['активный','b-paid'],['спящий','b-spyash'],['завершён','b-deal'],['отказ','b-otkaz']]
    .map(([имя,кл])=>'<button class="mini-btn '+(кл==='b-vnim'?'':'ghost')+'" onclick="filterProgress(\''+имя+'\')">'+имя+': <b>'+(с[имя]||0)+'</b></button>').join('');
  const в=progressSummary.воронка||{};
  const воронка=['контакт','ответ','кп','договор','оплата','работа']
    .map(э=>'<span>'+э+': <b class="lime">'+(в[э]||0)+'</b></span>').join('');
  box.innerHTML=шапка+`<div class="section">
    <div class="lc-meta" style="margin-bottom:12px">${воронка}</div>
    <div class="row-tools">
      <input class="inp" id="pSearch" placeholder="Поиск: имя, ник, ниша, uid" oninput="filterProgress()">
      <select class="sel" id="pStatus" onchange="filterProgress()">
        <option value="">Все статусы</option>
        <option value="требует внимания">Требуют внимания</option>
        <option value="активный">Активные</option>
        <option value="спящий">Спящие</option>
        <option value="завершён">Завершённые</option>
        <option value="отказ">Отказы</option>
      </select>
    </div>
    <div class="btnrow" style="margin-bottom:12px">${плитки}</div>
    <div id="progressList"></div>
  </div>`;
  filterProgress();
}
function filterProgress(статус){
  if(статус!==undefined){const s=document.getElementById('pStatus');if(s)s.value=статус}
  const q=(document.getElementById('pSearch')?.value||'').toLowerCase();
  const st=document.getElementById('pStatus')?.value||'';
  const list=progressData.filter(k=>{
    if(st&&k.статус!==st)return false;
    if(!q)return true;
    return ((k.имя||'')+' '+(k.ник||'')+' '+(k.ниша||'')+' '+(k.uid||'')).toLowerCase().includes(q);
  });
  const el=document.getElementById('progressList');
  if(!el)return;
  el.innerHTML='<div style="font-size:12px;color:var(--w3);margin-bottom:8px">Показано: '+list.length+' из '+progressData.length+'</div>'
    +(list.length?list.slice(0,300).map(progressCard).join(''):'<div class="empty">Ничего не найдено</div>');
}
function progressCard(k){
  const кл=СТАТУС_КЛАСС[k.статус]||'b-new';
  const шкала=(k.этапы||[]).map(э=>'<div class="step'+(э.есть?' on':'')+'" title="'+esc(э.этап+(э.чем?': '+э.чем:''))+'"></div>').join('');
  const подписи=(k.этапы||[]).map(э=>'<span class="'+(э.есть?'on':'')+'">'+esc(э.этап)+'</span>').join('');
  const ник=k.ник?'<a href="https://t.me/'+esc(k.ник)+'" target="_blank" onclick="event.stopPropagation()">@'+esc(k.ник)+'</a>':'';
  return`<div class="lc" onclick="openProgress('${esc(k.uid)}',this,event)">
    <div class="lc-top"><div class="lc-name">${esc(k.имя||'без имени')} <span style="color:var(--w4);font-size:11px">${esc(k.uid)}</span></div>
      <span class="badge ${кл}">${esc(k.статус)} ${k.прогресс}/${k.всего}</span></div>
    <div class="steps">${шкала}</div><div class="step-lbl">${подписи}</div>
    <div class="lc-meta" style="margin-top:7px">${ник}${k.ниша?'<span>'+esc(k.ниша)+'</span>':''}${k.стадия?'<span>'+esc(k.стадия)+'</span>':''}${k.оплачено?'<span class="lime">'+rub(k.оплачено)+'</span>':''}${k.аккаунт?'<span>'+esc(k.аккаунт)+'</span>':''}<span style="color:var(--amber)">${esc(k.почему||'')}</span></div>
    <div class="pdetail"></div></div>`;
}
function openProgress(uid,el,ev){
  if(ev&&ev.target.closest('a,button'))return;
  const box=el.querySelector('.pdetail');
  if(box.dataset.open){box.innerHTML='';box.dataset.open='';return}
  box.dataset.open='1';
  const k=progressData.find(x=>String(x.uid)===String(uid));
  if(!k){box.innerHTML='<div class="detail">Карточка не найдена</div>';return}
  let h='<div class="detail">';
  h+='<div style="font-size:11px;color:var(--w3);text-transform:uppercase;margin-bottom:6px">Отметки</div>';
  (k.этапы||[]).forEach(э=>{h+='<div class="agr"><span>'+(э.есть?'<span class="lime">✓</span> ':'<span style="color:var(--w4)">·</span> ')+esc(э.этап)+'</span><span style="color:var(--w3)">'+esc(э.чем||'нет')+'</span></div>'});
  const сог=k.соглашения||[];
  h+='<div style="font-size:11px;color:var(--w3);text-transform:uppercase;margin:14px 0 6px">Соглашения'+(сог.length?' ('+сог.length+')':'')+'</div>';
  if(!сог.length)h+='<div style="color:var(--w3);font-size:12.5px">Договоров пока нет</div>';
  сог.forEach(s=>{
    const ссылки=[s.договор?'<a class="lime" href="'+esc(s.договор)+'" target="_blank">договор</a>':'',
                  s.оплата?'<a class="lime" href="'+esc(s.оплата)+'" target="_blank">оплата</a>':''].filter(Boolean).join(' · ');
    h+='<div class="agr"><span><b>'+esc(s.тариф||'тариф')+'</b> '+(s.дней?'· '+s.дней+' дн':'')+'</span>'
      +'<span>'+(s.сумма?rub(s.сумма)+' ':'')+(s.оплачен?'<span class="lime">оплачен'+(s.доля?', '+esc(s.доля):'')+'</span>':'<span style="color:var(--amber)">не оплачен</span>')+' '+ссылки+'</span></div>';
  });
  const зам=k.заметки||[];
  h+='<div style="font-size:11px;color:var(--w3);text-transform:uppercase;margin:14px 0 6px">Заметки'+(зам.length?' ('+зам.length+')':'')+'</div>';
  if(!зам.length)h+='<div style="color:var(--w3);font-size:12.5px">Заметок пока нет</div>';
  зам.forEach(z=>{h+='<div class="note"><div class="who">'+esc(z.кто||'')+' · '+agoU(z.когда)+'</div>'+esc(z.текст||'')+'</div>'});
  h+='<div class="btnrow"><button class="mini-btn" onclick="event.stopPropagation();addNote(\''+esc(k.uid)+'\')">Добавить заметку</button>';
  if(k.ник)h+='<a class="mini-btn ghost" href="https://t.me/'+esc(k.ник)+'" target="_blank" onclick="event.stopPropagation()">Написать в TG</a>';
  if((k.ссылки||{}).кп)h+='<a class="mini-btn ghost" href="'+esc(k.ссылки.кп)+'" target="_blank" onclick="event.stopPropagation()">КП</a>';
  h+='</div></div>';
  box.innerHTML=h;
}
async function addNote(uid){
  const t=prompt('Заметка по клиенту (дописывается, старое не затирается):','');
  if(!t)return;
  const r=await apiPost('admin_note',{uid,text:t,who:'Даниэль'});
  if(!r.ok){alert('Не записалось: '+(r.error||''));return}
  // Снимок пересобирается сборщиком, поэтому дописываем локально сразу:
  // иначе заметка «пропадёт» до следующей сборки и её напишут второй раз.
  const k=progressData.find(x=>String(x.uid)===String(uid));
  if(k){(k.заметки=k.заметки||[]).unshift({кто:'Даниэль',когда:Math.floor(Date.now()/1000),текст:t})}
  filterProgress();
}

/* ========== ПРОСТЫЕ ЛИСТИНГИ ========== */
async function renderList(box,action,key,render,emptyMsg){
  const d=await api(action);
  const arr=(d[key]||[]);
  box.innerHTML='<div class="section">'+(arr.length?arr.map(render).join(''):'<div class="empty">'+emptyMsg+'</div>')+'</div>';
}
async function renderAnketasList(box){
  const d=await api('getAnketas');
  const arr=(d.anketas||[]);
  box.innerHTML='<div class="section">'+(arr.length?arr.map(renderAnketa).join(''):'<div class="empty">Анкет пока нет</div>')+'</div>';
}
function renderAnketa(a){return`<div class="lc"><div class="lc-top"><div class="lc-name">${esc(a.client_name||'Клиент')}</div><span class="badge ${a.complete?'b-paid':'b-wait'}">${a.complete?'готова':'частично'}</span></div><div class="lc-meta">${a.service_type?'<span>'+esc(productName(a.service_type))+'</span>':''}${a.email?'<span>'+esc(a.email)+'</span>':''}${a.tg?'<a href="https://t.me/'+esc(a.tg)+'">@'+esc(a.tg)+'</a>':''}<span>${num(a.progress)}/${a.total||'?'}</span>${a.created_at?'<span>'+when(a.created_at)+'</span>':''}</div><div style="margin-top:10px;display:flex;gap:6px;flex-wrap:wrap"><a class="mini-btn ghost" href="${API}?action=downloadAnketaPdf&id=${encodeURIComponent(a.submission_id||a.id)}&key=${encodeURIComponent(adminKey)}" target="_blank">PDF</a><a class="mini-btn ghost" href="${API}?action=downloadAnketa&id=${encodeURIComponent(a.submission_id||a.id)}&key=${encodeURIComponent(adminKey)}" target="_blank">ZIP</a></div></div>`}
function renderDialog(m){return`<div class="lc"><div class="lc-top"><div class="lc-name">${esc(m.client_name||m.name||m.username||'—')}</div><span class="badge b-new">${esc(m.account||m.role||'')}</span></div><div class="lc-meta">${when(m.created_at||m.ts)}</div><div class="detail" style="border:none;padding:6px 0 0">${esc((m.message||m.text||m.snippet||'').slice(0,240))}</div></div>`}
function renderCall(c){
  const l=c.ссылки||c.links||{};
  const когда=esc(c.когда||c.when||'');
  const ссылки=[
    l.kp?'<a href="'+esc(l.kp)+'" target="_blank">КП</a>':'',
    l.contract?'<a href="'+esc(l.contract)+'" target="_blank">Договор</a>':'',
    l.sistema?'<a href="'+esc(l.sistema)+'" target="_blank">Система</a>':'',
    l.dialog?'<a href="'+esc(l.dialog)+'" target="_blank">Диалог</a>':''
  ].filter(Boolean).join(' · ');
  const zoom=c.zoom?'<a class="lime" href="'+esc(c.zoom)+'" target="_blank">Войти в Zoom</a>'
                   :'<span class="b-wait">Zoom не создан</span>';
  return`<div class="lc"><div class="lc-top"><div class="lc-name">${esc(c.фио||c.name||'Клиент')}${c.ник?' · @'+esc(c.ник):''}</div><span class="badge b-deal">${когда} МСК</span></div>
  <div class="lc-meta">${c.ниша?'<span>'+esc(c.ниша)+'</span>':''}${c.бюджет?'<span class="lime">'+rub(c.бюджет)+'</span>':''}<span>${zoom}</span></div>
  ${ссылки?'<div class="lc-meta">'+ссылки+'</div>':''}
  ${c.сводка?'<div class="detail" style="border:none;padding:6px 0 0">'+esc(String(c.сводка).slice(0,300))+'</div>':''}</div>`}
function renderDeal(d){return`<div class="lc"><div class="lc-top"><div class="lc-name">${esc(d.name||d.client_name||'Сделка')}</div><span class="badge b-deal">${esc(productName(d.product)||d.status||'deal')}</span></div><div class="lc-meta">${d.amount?'<span class="lime">'+rub(d.amount)+'</span>':''}${when(d.created_at||d.ts)}</div></div>`}
function renderVac(v){return`<div class="lc"><div class="lc-top"><div class="lc-name">${esc(v.source||v.niche||'Вакансия')}</div>${v.score?'<span class="badge b-deal">'+esc(v.score)+'</span>':''}</div><div class="lc-meta">${v.niche?'<span>'+esc(v.niche)+'</span>':''}${when(v.created_at||v.ts)}</div><div class="detail" style="border:none;padding:6px 0 0">${esc((v.text||'').slice(0,200))}</div></div>`}
function renderResp(r){return`<div class="lc"><div class="lc-top"><div class="lc-name">${esc(r.account||r.username||'Отклик')}</div><span class="badge b-new">${esc(r.niche||'')}</span></div><div class="lc-meta">${when(r.created_at||r.ts)}</div><div class="detail" style="border:none;padding:6px 0 0">${esc((r.message||r.text||'').slice(0,200))}</div></div>`}
function renderPay(p){return`<div class="lc"><div class="lc-top"><div class="lc-name">${esc(p.name||'—')}</div><span class="badge b-paid">${rub(p.amount)}</span></div><div class="lc-meta">${p.product?'<span>'+esc(productName(p.product))+'</span>':''}${p.email?'<span>'+esc(p.email)+'</span>':''}${when(p.created_at||p.ts)}${p.manual?' <span class="amber">(вручную)</span>':''}</div></div>`}

async function renderProducts(box){
  const d=await api('getProducts');const arr=(d.products||[]);
  box.innerHTML='<div class="section cards-grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:12px">'+(arr.map(p=>`<div class="card"><div class="card-h"><span class="h-lbl">${esc(productName(p.key)||p.name)}</span></div><div style="display:flex;gap:18px;flex-wrap:wrap"><div><div class="kpi-n" style="font-size:22px">${num(p.leads)}</div><div class="kpi-l">Лидов</div></div><div><div class="kpi-n" style="font-size:22px">${num(p.paid)}</div><div class="kpi-l">Оплат</div></div><div><div class="kpi-n" style="font-size:22px">${num(p.leads)?Math.round(num(p.paid)/num(p.leads)*100):0}%</div><div class="kpi-l">Конверсия</div></div></div></div>`).join('')||'<div class="empty">Пусто</div>')+'</div>';
}
async function renderNewsletter(box){
  const d=await api('getSubscribers');const subs=(d.subscribers||[]);const log=(d.log||[]);
  const paid=subs.filter(s=>Number(s.paid)===1).length;
  box.innerHTML=`<div class="section">
    <div class="card" style="margin-bottom:14px">
      <div class="card-h"><span class="h-lbl">Новая рассылка</span></div>
      <div style="display:flex;flex-direction:column;gap:10px">
        <select class="sel" id="nlSeg"><option value="all">Всем (${subs.length})</option><option value="paid">Оплатившим (${paid})</option><option value="unpaid">Не оплатившим (${subs.length-paid})</option></select>
        <input class="inp" id="nlSubj" placeholder="Тема письма">
        <textarea class="inp" id="nlBody" rows="6" placeholder="Текст письма (можно {{name}} для имени)"></textarea>
        <div style="display:flex;gap:10px;flex-wrap:wrap"><input class="inp" id="nlBt" placeholder="Текст кнопки (опц.)" style="flex:1;min-width:140px"><input class="inp" id="nlBu" placeholder="Ссылка кнопки (опц.)" style="flex:1;min-width:140px"></div>
        <button class="btn" style="width:auto" onclick="sendNl()">Отправить рассылку</button>
        <div id="nlRes" style="font-size:13px;color:var(--lime)"></div>
      </div>
    </div>
    <div class="card-h"><span class="h-lbl">История рассылок</span></div>
    ${log.map(l=>`<div class="lc"><div class="lc-top"><div class="lc-name">${esc(l.subject)}</div><span class="badge b-deal">${esc(l.segment)}</span></div><div class="lc-meta"><span class="lime">Отправлено: ${num(l.sent)}</span><span>Ошибок: ${num(l.failed)}</span>${when(l.created_at)}</div></div>`).join('')||'<div class="empty">Рассылок пока не было</div>'}
  </div>`;
}
async function sendNl(){
  const subject=document.getElementById('nlSubj').value.trim();
  const content=document.getElementById('nlBody').value.trim();
  if(!subject||!content){document.getElementById('nlRes').textContent='Заполни тему и текст';return}
  document.getElementById('nlRes').textContent='Отправляю…';
  const r=await apiPost('sendNewsletter',{segment:document.getElementById('nlSeg').value,subject,content,btnText:document.getElementById('nlBt').value.trim(),btnUrl:document.getElementById('nlBu').value.trim()});
  document.getElementById('nlRes').textContent=r.ok?('Готово. Отправлено: '+r.sent+', ошибок: '+r.failed):('Ошибка: '+(r.error||'сеть'));
  if(r.ok)setTimeout(()=>loadPage('newsletter'),1500);
}

if(adminKey){api('admin_dashboard').then(r=>{if(r.ok){document.getElementById('login').classList.add('hide');document.getElementById('app').classList.remove('hide');go('dashboard')}else{document.getElementById('pw').focus()}})}
else{document.getElementById('pw').focus()}
</script>
