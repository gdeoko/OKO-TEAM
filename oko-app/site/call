<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1">
<title>Созвон - OKO TEAM</title>
<link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@700;900&family=Onest:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
:root{--lime:#9AFF00;--bg:#050505;--bg2:#0d0d0d;--b:rgba(154,255,0,.15);--w2:rgba(255,255,255,.55);--w3:rgba(255,255,255,.3);--amber:#ffb400}
body{background:var(--bg);color:#fff;font-family:'Onest',sans-serif;min-height:100vh;padding:0 0 110px}
.wrap{max-width:560px;margin:0 auto}
.top{position:sticky;top:0;z-index:10;background:rgba(5,5,5,.92);backdrop-filter:blur(10px);padding:16px 18px 14px;border-bottom:1px solid rgba(255,255,255,.05)}
.logo{font-family:'Unbounded';font-size:15px;font-weight:900;letter-spacing:1px}
.logo span{color:var(--lime)}
.pad{padding:22px 18px}
h1{font-family:'Unbounded';font-size:clamp(21px,5.5vw,27px);font-weight:700;line-height:1.22;margin-bottom:10px}
.sub{font-size:14px;color:var(--w2);line-height:1.55;margin-bottom:22px}
.day{font-size:12px;color:var(--lime);font-weight:700;letter-spacing:.6px;text-transform:uppercase;margin:22px 0 10px}
.slots{display:grid;grid-template-columns:repeat(auto-fill,minmax(96px,1fr));gap:9px}
.slot{background:var(--bg2);border:1.5px solid rgba(255,255,255,.1);border-radius:13px;padding:14px 8px;font-size:16px;font-weight:600;cursor:pointer;transition:.15s;text-align:center}
.slot:hover{border-color:rgba(154,255,0,.4)}
.slot.sel{border-color:var(--lime);background:rgba(154,255,0,.1);color:var(--lime)}
label{display:block;font-size:13px;color:var(--w2);margin:18px 0 7px}
input,textarea{width:100%;background:var(--bg2);border:1px solid rgba(255,255,255,.1);border-radius:14px;padding:15px 16px;color:#fff;font-size:16px;font-family:inherit;outline:none;transition:border .2s}
input:focus,textarea:focus{border-color:var(--lime)}
textarea{min-height:88px;resize:vertical}
.nav{position:fixed;bottom:0;left:0;right:0;background:rgba(5,5,5,.96);backdrop-filter:blur(10px);border-top:1px solid rgba(255,255,255,.06);padding:14px 18px}
.navin{max-width:560px;margin:0 auto}
.btn{width:100%;padding:16px;border-radius:14px;font-family:'Unbounded';font-size:13px;font-weight:700;border:none;cursor:pointer;background:var(--lime);color:#000;transition:.2s}
.btn:disabled{background:rgba(255,255,255,.1);color:var(--w3);cursor:not-allowed}
.note{background:rgba(255,255,255,.04);border-left:2px solid var(--lime);padding:12px 14px;border-radius:0 10px 10px 0;font-size:13.5px;line-height:1.55;color:var(--w2);margin-top:18px}
.warn{background:rgba(255,180,0,.1);border-left-color:var(--amber);color:#ffd479}
.ok{text-align:center;padding:48px 20px}
.ok .tick{width:64px;height:64px;border-radius:50%;background:rgba(154,255,0,.12);display:flex;align-items:center;justify-content:center;margin:0 auto 20px}
.ok h2{font-family:'Unbounded';font-size:22px;margin-bottom:12px}
.spin{width:26px;height:26px;border:2.5px solid rgba(255,255,255,.15);border-top-color:var(--lime);border-radius:50%;animation:s .8s linear infinite;margin:44px auto}
@keyframes s{to{transform:rotate(360deg)}}
.err{color:#ff6b6b;font-size:13.5px;margin-top:10px}
</style>
</head>
<body>
<div class="top"><div class="wrap"><div class="logo">OKO<span>.</span>TEAM</div></div></div>
<div class="wrap" id="root"><div class="spin"></div></div>
<div class="nav" id="navbar" style="display:none"><div class="navin">
  <button class="btn" id="go" disabled onclick="забронировать()">Записаться</button>
</div></div>

<script>
var API='/api.php';
var слаг=(location.pathname.match(/^\/call-([\w-]+)/)||[])[1]||'';
var выбран='', слоты=[], занятость=null;

function esc(s){return String(s==null?'':s).replace(/[&<>"]/g,function(c){
  return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]})}

/* Даты показываем словами: «завтра, 18 августа, вторник» читается с одного
   взгляда, а 2026-08-18T15:00 надо расшифровывать. */
var МЕС=['января','февраля','марта','апреля','мая','июня','июля','августа',
         'сентября','октября','ноября','декабря'];
var ДНИ=['воскресенье','понедельник','вторник','среда','четверг','пятница','суббота'];
function деньСловами(iso){
  var d=new Date(iso.replace(' ','T'));
  if(isNaN(d))return iso.slice(0,10);
  var сегодня=new Date(), завтра=new Date(Date.now()+86400000);
  var одинаковый=function(a,b){return a.toDateString()===b.toDateString()};
  var префикс=одинаковый(d,сегодня)?'сегодня, ':одинаковый(d,завтра)?'завтра, ':'';
  return префикс+d.getDate()+' '+МЕС[d.getMonth()]+', '+ДНИ[d.getDay()];
}
function времяСлота(iso){return iso.slice(11,16)}

function загрузить(){
  fetch(API+'?action=callSlots&slug='+encodeURIComponent(слаг)+'&_='+Date.now())
    .then(function(r){return r.json()})
    .then(function(d){
      if(!d||!d.ok){показатьОшибку(d&&d.error||'не отвечает');return}
      слоты=d.slots||[]; занятость=d.booked||null;
      нарисовать(d);
    })
    .catch(function(){показатьОшибку('нет связи')});
}

function показатьОшибку(текст){
  document.getElementById('root').innerHTML=
    '<div class="pad"><h1>Не получилось открыть время</h1>'
    +'<div class="sub">'+esc(текст)+'. Напишите нам в Телеграм, подберём время руками: '
    +'<a style="color:var(--lime)" href="https://t.me/ktodaniel">@ktodaniel</a></div></div>';
}

function нарисовать(d){
  /* Уже записан: показываем запись, а не даём записаться второй раз. */
  if(занятость){
    document.getElementById('root').innerHTML='<div class="pad">'
      +'<h1>Созвон уже назначен</h1>'
      +'<div class="sub">'+esc(деньСловами(занятость.когда))+', в <b>'+esc(времяСлота(занятость.когда))+'</b> по Москве.</div>'
      +(занятость.zoom?'<div class="note">Ссылка на встречу: <a style="color:var(--lime)" href="'+esc(занятость.zoom)+'">'+esc(занятость.zoom)+'</a></div>'
        :'<div class="note warn">Ссылку на встречу пришлём в Телеграм до созвона.</div>')
      +'<div class="note">Нужно перенести или отменить: напишите '
      +'<a style="color:var(--lime)" href="https://t.me/ktodaniel">@ktodaniel</a>.</div></div>';
    return;
  }
  if(!слоты.length){
    document.getElementById('root').innerHTML='<div class="pad">'
      +'<h1>Свободного времени сейчас нет</h1>'
      +'<div class="sub">Ближайшие окна разобраны. Напишите в Телеграм '
      +'<a style="color:var(--lime)" href="https://t.me/ktodaniel">@ktodaniel</a>, подберём время.</div></div>';
    return;
  }
  var поДням={}, порядок=[];
  слоты.forEach(function(s){
    var к=s.slice(0,10);
    if(!поДням[к]){поДням[к]=[];порядок.push(к)}
    поДням[к].push(s);
  });
  var h='<div class="pad"><h1>Выберите время созвона</h1>'
    /* Про ссылку тут не обещаем «сразу»: встречу создаёт бот, и если ключей
       Zoom нет, ссылки в момент записи не будет. Обещание, которое страница
       не может сдержать сама, писать нельзя. */
    +'<div class="sub">'+(d.name?esc(d.name)+', в':'В')+'ремя московское, разговор занимает 30-40 минут. '
    +'Ссылку на встречу пришлём в Телеграм до созвона.</div>';
  порядок.forEach(function(к){
    h+='<div class="day">'+esc(деньСловами(поДням[к][0]))+'</div><div class="slots">';
    поДням[к].forEach(function(s){
      h+='<div class="slot" data-iso="'+esc(s)+'" onclick="выбрать(this)">'+esc(времяСлота(s))+'</div>';
    });
    h+='</div>';
  });
  h+='<label for="tema">О чём поговорить (необязательно)</label>'
    +'<textarea id="tema" placeholder="Например: сроки, что входит в работу, как считается цена"></textarea>'
    +'<label for="kontakt">Телеграм или телефон для связи</label>'
    +'<input id="kontakt" placeholder="@ник или +7..." value="'+esc(d.contact||'')+'">'
    +'<div class="note">Созвон ни к чему не обязывает. Если после разговора решите не работать, просто скажете.</div>'
    +'<div id="err"></div></div>';
  document.getElementById('root').innerHTML=h;
  document.getElementById('navbar').style.display='block';
}

function выбрать(el){
  document.querySelectorAll('.slot').forEach(function(s){s.classList.remove('sel')});
  el.classList.add('sel');
  выбран=el.dataset.iso;
  document.getElementById('go').disabled=false;
  document.getElementById('go').textContent='Записаться на '+времяСлота(выбран);
}

function забронировать(){
  if(!выбран)return;
  var кн=document.getElementById('go');
  кн.disabled=true; кн.textContent='Записываю...';
  fetch(API+'?action=callBook',{method:'POST',headers:{'Content-Type':'application/json'},
    body:JSON.stringify({slug:слаг,when:выбран,
      topic:(document.getElementById('tema')||{}).value||'',
      contact:(document.getElementById('kontakt')||{}).value||''})})
    .then(function(r){return r.json()})
    .then(function(d){
      if(!d||!d.ok){
        document.getElementById('err').innerHTML='<div class="err">Не записалось: '
          +esc(d&&d.error||'попробуйте ещё раз')+'</div>';
        кн.disabled=false; кн.textContent='Записаться'; return;
      }
      document.getElementById('navbar').style.display='none';
      document.getElementById('root').innerHTML='<div class="ok">'
        +'<div class="tick"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#9AFF00" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg></div>'
        +'<h2>Записал</h2>'
        +'<div class="sub">'+esc(деньСловами(выбран))+', в <b>'+esc(времяСлота(выбран))+'</b> по Москве.</div>'
        /* Про ссылку говорим честно: если встречу создать не вышло, обещать
           её «в письме» нельзя - человек будет ждать и не дождётся. */
        +(d.zoom?'<div class="note">Ссылка на встречу: <a style="color:var(--lime)" href="'+esc(d.zoom)+'">'+esc(d.zoom)+'</a></div>'
          :'<div class="note warn">Ссылку на встречу пришлём в Телеграм заранее.</div>')
        +'</div>';
    })
    .catch(function(){
      document.getElementById('err').innerHTML='<div class="err">Нет связи. Попробуйте ещё раз.</div>';
      кн.disabled=false; кн.textContent='Записаться';
    });
}
загрузить();
</script>
</body>
</html>
