<!-- Проба логики: домен, разбор подписки, сборка конфига.
     Окна здесь нет, поэтому гоняется и на Windows, и под mono.
     Запуск: dotnet build проба/проба.csproj -c Release, затем
     запустить проба.exe. Ноль на выходе значит всё сошлось. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>RocketVPN</RootNamespace>
    <AssemblyName>проба</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../src/RocketVPN/Узел.cs" />
    <Compile Include="../src/RocketVPN/Подписка.cs" />
    <Compile Include="../src/RocketVPN/ФорматыПодписки.cs" />
    <Compile Include="../src/RocketVPN/Настройки.cs" />
    <Compile Include="../src/RocketVPN/Сеть.cs" />
    <Compile Include="../src/RocketVPN/Конфиг.cs" />
    <Compile Include="проба.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Drawing" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
</Project>
