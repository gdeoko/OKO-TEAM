{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "ToolSearch",
      "WebSearch",
      "WebFetch",
      "mcp__github",
      "mcp__github__*",
      "mcp__Claude_Code_Remote",
      "mcp__Claude_Code_Remote__*",
      "mcp__Magic_Patterns",
      "mcp__Magic_Patterns__*",
      "mcp__Higgsfield",
      "mcp__Higgsfield__*",
      "mcp__Canva",
      "mcp__Canva__*",
      "mcp__Adobe_for_creativity",
      "mcp__Adobe_for_creativity__*",
      "mcp__Adobe_Marketing_Agent",
      "mcp__Adobe_Marketing_Agent__*",
      "mcp__Figma",
      "mcp__Figma__*",
      "mcp__Zapier",
      "mcp__Zapier__*",
      "mcp__Hugging_Face",
      "mcp__Hugging_Face__*",
      "mcp__Zoom_for_Claude",
      "mcp__Zoom_for_Claude__*",
      "mcp__Gmail",
      "mcp__Gmail__*",
      "Artifact",
      "SendUserFile",
      "Skill",
      "Monitor",
      "Workflow",
      "Agent",
      "TaskCreate",
      "TaskUpdate",
      "TaskList",
      "TaskGet",
      "TaskStop",
      "TaskOutput",
      "NotebookEdit",
      "EnterWorktree",
      "ExitWorktree",
      "CronCreate",
      "CronList",
      "CronDelete",
      "PushNotification",
      "ScheduleWakeup",
      "SendMessage",
      "ListSkills",
      "SearchSkills",
      "ListPlugins",
      "SearchPlugins",
      "ListConnectors"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"allow\",\"permissionDecisionReason\":\"OKO: авто-одобрение (правило Даниэля)\"}}'"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" 2>/dev/null || cd /home/user/OKO-TEAM; [ -f secrets.env.b64 ] && base64 -d secrets.env.b64 > secrets.env 2>/dev/null; for f in ~/.bashrc ~/.profile; do grep -q '# oko-secrets' \"$f\" 2>/dev/null || echo 'source /home/user/OKO-TEAM/secrets.env 2>/dev/null # oko-secrets' >> \"$f\"; done; echo 'OKO: ключи интеграций загружены (secrets.env), паспорт: INTEGRATIONS.md'"
          }
        ]
      }
    ]
  }
}