# =============================================================================
# secrets.env.example — переменные окружения контент-завода
# Скопировать в secrets.env и заполнить, ЗАПРЕЩЕНО коммитить в git.
# Боевые значения — только в OKO_MASTER_VAULT.md.
# =============================================================================

# --- Стоки видео/фото ---
PEXELS_API_KEY=
PIXABAY_API_KEY=

# --- Звук ---
FREESOUND_API_KEY=
FREESOUND_CLIENT_ID=

# --- 3D ---
SKETCHFAB_API_KEY=

# --- AI / генерация ---
# Gemini (главный мозг + транскрипт + аудит)
GEMINI_API_KEYS=key1,key2,key3,key4
GEMINI_BASE_URL=https://gemini-proxy.okoteam.workers.dev
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_TEXT_MODEL=gemini-2.5-flash

# Higgsfield (обложки, карусели) — через MCP-коннектор, ключа тут нет
# HF S3 для тяжёлых видео
HF_S3_ENDPOINT=https://s3.hf.co/okoteam
HF_S3_ACCESS_KEY=
HF_S3_SECRET_KEY=

# Hugging Face (модели для видео/картинок в резерве)
HF_TOKEN=

# Anthropic резерв
ANTHROPIC_BASE_URL=https://anthropic-proxy.okoteam.workers.dev

# --- Хранилища ---
# Cloudflare R2 (тяжёлые видео клиентов)
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=oko-content-factory

# Twcstorage S3 (резерв)
TWC_S3_ENDPOINT=https://s3.twcstorage.ru
TWC_S3_KEY=
TWC_S3_SECRET=
TWC_S3_BUCKET=oko-media

# --- Публикация ---
# Hooppy (планировщик всех соцсетей)
HOOPPY_API_BASE=https://api.hooppy.ru/api
HOOPPY_API_TOKEN=

# YouTube — общие OAuth-клиенты OKO
YT_CLIENT_ID=
YT_CLIENT_SECRET=

# Instagram Graph API
IG_APP_ID=
IG_APP_SECRET=

# TikTok Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- Аналитика ---
# Yandex.Metrika
METRIKA_OAUTH_TOKEN=

# Google Analytics 4
GA4_SERVICE_ACCOUNT_JSON_PATH=/opt/oko/secrets/ga4-sa.json

# --- Уведомления ---
# Telegram бот для утренних отчётов и алертов
TG_BOT_TOKEN=

# --- Инструменты ---
# yt-dlp (для скачивания конкурентов)
YT_DLP_COOKIES=/opt/oko/cookies.txt

# Apify (для скрапинга IG/TikTok когда нет прямого API)
APIFY_TOKEN=

# --- CA bundle для агент-прокси (обязательно на VPS) ---
CA_BUNDLE=/root/.ccr/ca-bundle.crt
