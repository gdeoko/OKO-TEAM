# =========================================================
# td-art.ru → design.td-art.ru — 301 редиректы (fallback)
# Источник: jobs/td-art/redirects.csv (106 строк от Антона)
# Сгенерировано: jobs/td-art/gen.py
# Если WP-плагин Redirection импортирован — этот файл НЕ обязателен,
# но canonical-блок (www→non-www, http→https) держать в .htaccess ВСЕГДА.
# =========================================================

<IfModule mod_rewrite.c>
RewriteEngine On

# --- canonical: www → non-www ---
RewriteCond %{HTTP_HOST} ^www\.td-art\.ru$ [NC]
RewriteRule ^(.*)$ https://td-art.ru/$1 [R=301,L]

# --- canonical: http → https ---
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://td-art.ru/$1 [R=301,L]

# --- точные редиректы (в порядке из таблицы) ---
RewriteRule ^design\-project/dom/$ https://design.td-art.ru/folio [R=301,L]
RewriteRule ^design\-project/kvartira/$ https://design.td-art.ru/folio [R=301,L]
RewriteRule ^articles/interesnoe/elitnyj\-dizajn\-interera\-v\-chem\-zhe\-on\-zaklyuchaetsya/$ https://design.td-art.ru/folio [R=301,L]
RewriteRule ^articles/interesnoe/stil\-barokko\-v\-interere/$ https://design.td-art.ru/folio [R=301,L]
RewriteRule ^articles/gostinaya/osobennosti\-interera\-gostinoj\-v\-chastnom\-dome/$ https://design.td-art.ru/folio [R=301,L]
RewriteRule ^$ https://design.td-art.ru/ [R=301,L]
