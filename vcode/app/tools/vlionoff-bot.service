[Unit]
Description=V.LIONOFF bot (@vcodemedia_bot) - long-poll
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/vlionoff/vcode/app
ExecStart=/usr/bin/php /opt/vlionoff/vcode/app/bot/poll.php
Restart=always
RestartSec=5
StandardOutput=append:/var/log/vlionoff-bot.log
StandardError=append:/var/log/vlionoff-bot.log

[Install]
WantedBy=multi-user.target
