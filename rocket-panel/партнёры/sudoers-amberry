# Боту нужно поднимать и гасить копии партнёров, а это systemctl, то
# есть root. Даём ровно одну команду и ровно один скрипт - не sudo
# systemctl, который позволил бы перезапустить что угодно на сервере,
# включая саму админку и бэкапы.
#
# Скрипт проверяет свои аргументы по строгому образцу (id - цифры,
# токен - вид BotFather), потому что зовут его с данными, которые
# написал посторонний человек в телеграме.
#
# Кладётся в /etc/sudoers.d/amberry-partner с правами 0440.
amberry ALL=(root) NOPASSWD: /usr/local/sbin/amberry-partner
