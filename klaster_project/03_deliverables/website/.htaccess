Options -Indexes
<FilesMatch "config\.php$">Require all denied</FilesMatch>
<IfModule mod_headers.c>
  <FilesMatch "\.(jpg|jpeg|png|svg|woff2|css|js|ico)$">Header set Cache-Control "public, max-age=31536000, immutable"</FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>
RedirectMatch 403 ^/data/
